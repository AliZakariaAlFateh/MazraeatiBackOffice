@model SportFeatureModel

<style>
    .form-group {
        font-size: 13px;
    }
</style>    

@Html.HiddenFor(a => a.Id)
@* @Html.HiddenFor(a => a.CreatedDate) *@

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2><strong>معالجة</strong> السجل</h2>
                </div>
                <div class="body">
                    <div class="row clearfix">
                        <!-- ===== القسم الرياضي ===== -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>القسم الرياضي <span class="text-danger">*</span></label>
                                <select class="form-control select2" name="SportTypeId" id="SportTypeId">
                                    <option value="">-- اختر القسم --</option>
                                    @if (ViewBag.SportTypes != null)
                                    {
                                        foreach (var item in ViewBag.SportTypes)
                                        {
                                            <option value="@item.Id" selected="@(item.Id == Model.SportTypeId)">@item.NameAr</option>
                                        }
                                    }
                                </select>
                                @Html.ValidationMessageFor(a => a.SportTypeId, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- المرفق بالعربي -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.FeatureTextAr)
                                @Html.TextBoxFor(a => a.FeatureTextAr, new { @class = "form-control", @autocomplete = "off" })
                                @Html.ValidationMessageFor(a => a.FeatureTextAr, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- المرفق بالإنجليزي -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.FeatureTextEn)
                                @Html.TextBoxFor(a => a.FeatureTextEn, new { @class = "form-control", @autocomplete = "off" })
                                @Html.ValidationMessageFor(a => a.FeatureTextEn, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- الأيقونة -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.IconClass)
                                @Html.TextBoxFor(a => a.IconClass, new { @class = "form-control", @autocomplete = "off", @placeholder = "مثال: fa fa-star" })
                                @Html.ValidationMessageFor(a => a.IconClass, "", new { @style = "color:red;font-size:10px" })
                                <small class="text-muted">يمكنك استخدام أيقونات من <a href="https://fontawesome.com/icons" target="_blank">Font Awesome</a></small>
                            </div>
                        </div>

                        <!-- نشط -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.IsActive)
                                <br />
                                @Html.CheckBoxFor(a => a.IsActive, new { @class = "form-control", style = "width:20px;height:20px;margin-top:5px;" })
                            </div>
                        </div>

                        <!-- أزرار -->
                        <div class="col-sm-12">
                            <button type="submit" class="btn btn-primary btn-round">حفظ</button>
                            <button type="button" onclick="window.location.href='@Url.Action("Index", "SportFeatures")'" class="btn btn-default btn-round">رجوع</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>