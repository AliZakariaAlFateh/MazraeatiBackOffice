@model List<UserViewModel>

@{
    ViewData["Title"] = "Users Management";
    int row = 1;
}
<link href="~/assets/css/account_index_style.css" rel="stylesheet" />
<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-primary">المستخدمين</h5>
            <a asp-action="Register" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> مستخدم جديد
            </a>
        </div>
        <div class="card-body">
            <div id="alertContainer"></div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الاسم بالكامل</th>
                            <th>الإيميل</th>
                            <th>الصلاحيات</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr id="row-@user.Id">
                                <td style="font-weight: 600;">@row</td>
                                <td><strong>@user.UserName</strong></td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td class="roles-cell-@user.Id">
                                    <div style="display: flex; flex-wrap: wrap; gap: 0.3rem; justify-content: center;">
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="role-badge role-@role.ToLower()">@role</span>
                                        }
                                    </div>
                                </td>
                                <td class="status-cell-@user.Id">
                                    <span class="status-badge @(user.IsActive ? "active" : "inactive")">
                                        @(user.IsActive ? "نشط" : "غير نشط")
                                    </span>
                                </td>
                                <td>@user.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="action-buttons">
                                        <!-- زر إدارة الصلاحيات -->
                                        <a asp-action="ManagePermissions" asp-route-id="@user.Id" class="btn-action btn-permissions">
                                            <i class="fas fa-lock"></i> صلاحيات
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn-action btn-edit">
                                            <i class="fas fa-edit"></i> تعديل
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" style="display:inline" class="toggle-status-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action btn-toggle toggle-status-btn" data-user-id="@user.Id">
                                                @(user.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </form>

                                        @if (User.Identity.Name != user.UserName)
                                        {
                                            <button type="button" class="btn-action btn-delete delete-ajax-btn"
                                                    data-user-id="@user.Id"
                                                    data-user-name="@user.UserName"
                                                    data-user-fullname="@user.FullName">
                                                <i class="fas fa-trash"></i> حذف
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            row += 1;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script src="~/assets/js/account_index_user_authorization_roles.js"></script>

