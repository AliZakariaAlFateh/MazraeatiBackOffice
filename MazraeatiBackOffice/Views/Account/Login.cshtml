@{
    Layout = null;
}
@model MazraeatiBackOffice.Models.LoginModel
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Favicon icon -->
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <title>لوحة تحكم - تسجيل الدخول</title>
    <!-- page css -->
    <link href="@Url.Content("~/login/css/login-register-lock.css")" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="@Url.Content("~/login/css/style.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/login/css/fonts.css")" rel="stylesheet">
    <style>
        .btn-primary, .btn-primary:hover, .btn-primary:active {
            color: #ffffff !important;
            background-color: #9F9F9F !important;
            border-color: #9F9F9F !important;
        }

        .form-material .form-control, .form-material .form-control.focus, .form-material .form-control:focus {
            background-image: linear-gradient(#9F9F9F,#9F9F9F),linear-gradient(#e9ecef,#e9ecef);
        }

        .text-rainbow-animation {
            font-family: arial black;
            font-size: 70px;
            background-image: linear-gradient(to right, red, orange, yellow, green, blue, indigo, violet, red);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: rainbow-animation 80s linear infinite;
        }

        @@keyframes rainbow-animation {
            to {
                background-position: 4500vh;
            }
        }

        .bg {
            background-image: url( @Url.Content("~/1.jpg") );
            height: 100%;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            position: fixed;
            width: 100%;
        }

        .colorText {
            color: white !important;
        }

        input::placeholder {
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .login-box input {
            background: rgba(0, 0, 0, 0.15);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            padding: 12px;
        }

            .login-box input:focus {
                background: rgba(0, 0, 0, 0.3);
                color: #fff;
                border-color: #9F9F9F;
                outline: none;
                box-shadow: none;
            }

        .login-box {
            direction: rtl;
        }

        .alert-custom {
            background: rgba(220, 53, 69, 0.9);
            color: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 15px;
            text-align: center;
        }

        .alert-success-custom {
            background: rgba(40, 167, 69, 0.9);
            color: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 15px;
            text-align: center;
        }

        .validation-summary-errors {
            background: rgba(220, 53, 69, 0.9);
            color: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 15px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-right: 20px;
            }

        .field-validation-error {
            color: #ff6b6b;
            font-size: 12px;
            display: block;
            margin-top: 5px;
        }

        .remember-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 15px;
            margin-right: 15px;
        }

            .remember-checkbox input {
                width: 18px;
                height: 18px;
                margin: 0;
            }

            .remember-checkbox label {
                margin: 0;
                cursor: pointer;
                color: #ddd;
            }

        .login-title {
            margin-bottom: 30px;
            font-weight: bold;
        }
        /* ========== تحسينات الموبايل ========== */
        @@media (max-width: 768px) {
            /* إخفاء الصورة الثابتة القديمة */
        img [src*="logo_icon.jpg"]

        {
            display: none !important;
        }

       .login-register{
                margin-top: 200px;
            }

            #loginform{
                margin-top: 50px;
            }
       Image_logo{
                display: none !important;
       }
        /* جعل الفورم يأخذ عرض أكبر */
        .login-box {
            width: 92% !important;
            margin: 0 auto;
            margin-top: 30px;
        }

            /* إضافة صورة داخل الفورم في الموبايل */
            .login-box .card-body {
                position: relative;
                padding-top: 70px !important;
            }

                .login-box .card-body::before {
                    content: '';
                    display: block;
                    width: 80px;
                    height: 80px;
                    background: url('/logo_icon.jpg') no-repeat center center;
                    background-size: contain;
                    position: absolute;
                    top: -30px;
                    left: 50%;
                    transform: translateX(-50%);
                    border-radius: 50%;
                    background-color: rgba(255, 255, 255, 0.9);
                    padding: 10px;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
                }

            /* تقليل حجم الفورم */
            .login-box .card-body {
                padding: 20px 15px 30px !important;
            }

        /* تصغير حجم العنوان */
        .login-title {
            font-size: 20px !important;
            margin-bottom: 20px !important;
        }

        /* تصغير حجم المدخلات */
        .form-group .col-xs-12 input {
            font-size: 14px !important;
            padding: 10px 12px !important;
        }

        /* تصغير حجم الزر */
        .btn-block {
            font-size: 16px !important;
            padding: 12px !important;
        }

        /* تصغير حجم رسائل الأخطاء */
        .field-validation-error {
            font-size: 11px !important;
        }

        /* تحسين الـ checkbox */
        .remember-checkbox {
            margin-right: 0 !important;
            justify-content: center;
        }

            .remember-checkbox label {
                font-size: 14px;
            }

        }

        /* تحسين للشاشات الصغيرة جداً (أقل من 400px) */
        @@media (max-width: 400px) {
            .login-box .card-body::before

        {
            width: 60px;
            height: 60px;
            top: -25px;
        }

        .login-box .card-body {
            padding-top: 55px !important;
        }

        .login-title {
            font-size: 17px !important;
        }

        .btn-block {
            font-size: 14px !important;
            padding: 10px !important;
        }

        }
    </style>
</head>

<body class="skin-default card-no-border bg">
    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <!-------- image fixed position ------->
    <img class="Image_logo" src="@Url.Content("~/logo_icon.jpg")" width="150" height="120" style="position: fixed; top: 15px; right: 10px; z-index: 999;" alt="logo" />
    <!-------- image fixed position ------->

    <section id="wrapper">
        <div class="login-register">
            <div class="login-box card" style="background: rgba(0, 0, 0, 0.55); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.15); color: #fff; border-radius: 12px;">
                <div class="card-body" style="background: rgb(0 0 0 / 0%);">

                    <form class="form-horizontal form-material" id="loginform" asp-action="Login" asp-controller="Account" method="post">
                        @* @Html.AntiForgeryToken() *@

                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <h3 class="text-center login-title">تسجيل الدخول للنظام</h3>

                        <!-- عرض رسائل TempData -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert-success-custom">
                                @TempData["Success"]
                            </div>
                        }

                        <!-- عرض أخطاء الـ Model (Validation Summary) -->
                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                        <div class="form-group" style="margin-top: 30px;">
                            <div class="col-xs-12">
                                <input asp-for="UserName" class="form-control colorText"
                                       autocomplete="off" placeholder="اسم المستخدم" />
                                <span asp-validation-for="UserName" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="form-group" style="margin-top: 30px;">
                            <div class="col-xs-12">
                                <input asp-for="Password" class="form-control colorText"
                                       autocomplete="off" type="password" placeholder="كلمة المرور" />
                                <span asp-validation-for="Password" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="form-group remember-checkbox" style="margin-top: 15px;">
                            <div class="col-xs-12">
                                <input asp-for="RememberMe" type="checkbox" />
                                <label asp-for="RememberMe">تذكرني</label>
                            </div>
                        </div>

                        <div class="form-group text-center" style="margin-top: 40px;">
                            <div class="col-xs-12 p-b-20">
                                <button class="btn btn-block btn-lg btn-primary btn-rounded" type="submit"
                                        style="background-color: rgba(0, 0, 0, 0.6) !important; font-size: 13pt; font-weight: bold; border: 1px solid rgba(255,255,255,0.3); border-radius: 8px;">
                                    دخول
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- End Wrapper -->
    <!-- ============================================================== -->
    <!-- All Jquery -->
    <!-- ============================================================== -->
    <script src="~/login/js/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="~/login/js/popper.min.js"></script>
    <script src="~/login/js/bootstrap.min.js"></script>
    <!-- jQuery Validation for client-side validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <!--Custom JavaScript -->
    <script type="text/javascript">
        $(function () {
            $(".preloader").fadeOut();
        });
        $(function () {
            $('[data-toggle="tooltip"]').tooltip()
        });

        // منع إعادة إرسال النموذج عند التحديث
        if (window.history.replaceState) {
            window.history.replaceState(null, null, window.location.href);
        }
    </script>

</body>

</html>