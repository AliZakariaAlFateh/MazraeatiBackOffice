@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>غير مصرح - رفض الوصول</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #2f5c16 0%, #1f7023 100%); /* linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
        }

        .access-denied-container {
            text-align: center;
            padding: 40px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            max-width: 500px;
            margin: 20px;
        }

        .lock-icon {
            font-size: 80px;
            margin-bottom: 20px;
            animation: shake 0.5s ease-in-out;
        }

        h1 {
            font-size: 72px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        h2 {
            font-size: 28px;
            margin-bottom: 20px;
        }

        p {
            font-size: 16px;
            margin-bottom: 30px;
            line-height: 1.6;
            opacity: 0.9;
        }

        .user-info {
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: right;
        }

            .user-info p {
                margin: 5px 0;
            }

        .btn {
            display: inline-block;
            padding: 12px 30px;
            margin: 10px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-primary {
            background: #ff6b6b;
            color: white;
            border: 2px solid #ff6b6b;
        }

            .btn-primary:hover {
                background: transparent;
                color: #ff6b6b;
                transform: scale(1.05);
            }

        .btn-secondary {
            background: transparent;
            color: white;
            border: 2px solid white;
        }

            .btn-secondary:hover {
                background: white;
                color: #764ba2;
                transform: scale(1.05);
            }

        @@keyframes shake {
            0%, 100%

        {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-10px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(10px);
        }

        }

        .status-code {
            font-size: 14px;
            opacity: 0.7;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <div class="lock-icon">🔒</div>
        <h1>403</h1>
        <h2>رفض الوصول</h2>
        <p>عذراً، ليس لديك الصلاحية الكافية للوصول إلى هذه الصفحة.</p>

        @if (ViewBag.UserName != null)
        {
            <div class="user-info">
                <p><strong>المستخدم:</strong> @ViewBag.UserName</p>
                <p><strong>الصلاحية الحالية:</strong> @ViewBag.UserRole</p>
                <p><strong>الوقت:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
            </div>
        }

        <div>
            <a href="javascript:history.back()" class="btn btn-secondary">↩ العودة للصفحة السابقة</a>
            <a href="/Farmers/Index" class="btn btn-primary">🏠 الذهاب للرئيسية</a>
        </div>
        <div class="status-code">
            Error Code: ACCESS_DENIED_403
        </div>
    </div>
</body>
</html>