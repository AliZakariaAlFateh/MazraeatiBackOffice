@model IEnumerable<CityModel>
<style>
.table-scroll{
    height:350px;          
    overflow-y: scroll;     
}

/* Sticky header */
.table-scroll thead th{
    position: sticky;
    top: 0;
    background: #198754;
    color: #fff;
    z-index: 10;
}

/* Chrome / Edge */
.table-scroll::-webkit-scrollbar{
    width: 12px;
}
.table-scroll::-webkit-scrollbar-track{
    background: #eee;
}
.table-scroll::-webkit-scrollbar-thumb{
    background: #999;
    border-radius: 10px;
    border: 2px solid #eee;
}
.table-scroll::-webkit-scrollbar-thumb:hover{
    background: #666;
}

/* Firefox */
.table-scroll{
    scrollbar-width: auto;
    scrollbar-color: #999 #eee;
}
</style>
<div class="col-md-12">
    <div class="card patients-list">
        <div class="header">
            <h2><strong>قائمة</strong> المحافظات</h2>
            <ul class="header-dropdown">
            </ul>
        </div>
        <div class="body">
            <!-- Nav tabs -->
            @Html.Partial("_search")
            <!-- Tab panes -->
            <div class="tab-content m-t-10">
                <div class="tab-pane table-responsive active table-scroll" id="All" @* style="height:270px; overflow-y:auto;" *@>
                    <table class="table m-b-0 table-hover">
                        <thead style="background-color:#FD9C4E;color:white">
                            <tr>
                                <th>#</th>
                                <th>@Html.DisplayNameFor(a => a.DescAr)</th>
                                <th>@Html.DisplayNameFor(a => a.DescEn)</th>
                                <th>@Html.DisplayNameFor(a => a.CountryId)</th>
                                <th>@Html.DisplayNameFor(a => a.Active)</th>
                                <th>تفاصيل</th>
                                <th>إضافة منطقة</th>
                                <th>حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.DescAr</td>
                                <td>@item.DescEn</td>
                                <td>@item.CountryName</td>
                                <td><span class="badge badge-@(item.Active ? "success" : "danger")">@(item.Active ? "فعال" : "غير فعال")</span></td>
                                <td><a href="@Url.Content("~/city/edit/")@item.Id" style="height: 25px;" class="btn btn-primary btn-round"><i class="zmdi zmdi-edit" style="color: white;margin-top: -10px;"></i></a></td>
                                <td><a href="@Url.Content("~/region/index?cityid=")@item.Id" style="height: 25px;" class="btn btn-primary btn-round"><i class="zmdi zmdi-edit" style="color: white;margin-top: -10px;"></i></a></td>
                                <td>
                                    <a href="javascript:Delete('city',@item.Id,'Delete','Index')" class="btn btn-danger btn-sm">حذف</a>
                                </td>
                            </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
