        /* استهداف الـ Checkbox فقط */
        input[type="checkbox"] {
            width: 20px !important; /* الحجم المناسب عشان يكون سهل الضغط */
            height: 20px !important; /* الحجم المناسب */
            display: inline-block !important; /* عشان يجي جنب النص وما ياخدش سطر لوحده */
            cursor: pointer;
            margin: 5px; /* مسافة بسيطة حول الزر */
            -webkit-appearance: checkbox !important; /* لضمان ظهور شكل الـ checkbox الأصلي */
        }

        /* لو الـ Checkbox موجود جوه label أو div وعايزه يفضل في مكانه */
        .form-group input[type="checkbox"],
        .checkbox-inline input {
            width: auto !important;
            height: auto !important;
        }





        .table thead th {
            vertical-align: bottom;
            border-bottom: 1px solid #dee2e6;
        }

        .l-green {
            background: linear-gradient( 45deg, #ffcd04, #ffcd04) !important;
        }

        .text-rainbow-animation {
            font-family: arial black;
            font-size: 70px;
            background-image: linear-gradient(to right, red,orange,yellow,green,blue,indigo,violet, red);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: rainbow-animation 150s linear infinite;
        }

        @@keyframes rainbow-animation {
            to {
                background-position: 4500vh;
            }
        }

        table > thead {
            background-color: #007500 !important;
            color: white !important;
        }

        .notification-wrapper {
            position: relative;
            display: inline-block;
        }

        .noti-btn {
            font-size: 22px;
            background: none;
            border: none;
            cursor: pointer;
            position: relative;
        }

        .noti-count {
            position: absolute;
            top: -5px;
            right: -8px;
            background: #ff3b3b;
            color: #fff;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 11px;
            display: none;
        }

        .noti-dropdown {
            position: absolute;
            right: 0;
            top: 40px;
            width: 600px;
            max-height: 400px;
            overflow-y: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            opacity: 0;
            transform: translateY(-10px) scale(0.95);
            pointer-events: none;
            transition: all 0.3s ease;
            z-index: 999;
        }

            .noti-dropdown.active {
                opacity: 1;
                transform: translateY(0) scale(1);
                pointer-events: auto;
            }

        .noti-header {
            padding: 10px;
            font-weight: bold;
            border-bottom: 1px solid #eee;
            text-align: right;
        }

        #notiItems {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            #notiItems li {
                padding: 10px;
                border-bottom: 1px solid #f1f1f1;
                transition: 0.2s;
                cursor: pointer;
            }

                #notiItems li:hover {
                    background: #f9f9f9;
                }

        .noti-empty {
            text-align: center;
            color: #888;
        }

        .zmdi-notifications{
            color: ghostwhite;
            font-size: larger;
        }


      @@media (max-width: 576px) {
            .noti-dropdown {
                width: 90vw; /* تأخذ 90% من عرض الشاشة */
                position: fixed; /* لتتوسط الشاشة أو تظهر بشكل أوضح */
                left: 5%;
                right: 5%;
                top: 60px; /* اترك مسافة للهيدر */
            }
        }



