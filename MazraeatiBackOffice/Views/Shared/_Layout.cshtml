    <script>
        ///Side Bar
    const toggleBtn = document.getElementById("menu-toggle");
    const sidebar = document.getElementById("leftsidebar");
    const overlay = document.getElementById("sidebarOverlay");

    toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("active");
        overlay.classList.toggle("active");

        // تغيير الأيقونة
        this.innerHTML = sidebar.classList.contains("active")
            ? '<i class="zmdi zmdi-close"></i>'
            : '<i class="zmdi zmdi-menu"></i>';
    });

    // قفل عند الضغط خارجه
    overlay.addEventListener("click", function () {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        toggleBtn.innerHTML = '<i class="zmdi zmdi-menu"></i>';
    });

    ///Side Bar
    $(".menu-toggle").click(function (e) {
        e.preventDefault();

        var $this = $(this);
        var $submenu = $this.next();

        $(".menu-toggle").not($this).removeClass("toggled");
        $(".menu-toggle").not($this).next().slideUp();

        $this.toggleClass("toggled");
        $submenu.slideToggle();
    });
    $(document).ready(function () {
        $('.select2').select2({
            placeholder: "اختر من القائمة",
            width: '100%',
            dir: "rtl",
            closeOnSelect: false
        });
    });

    ////For Logout
    $('#adminName').on('click', function(e) {
                e.stopPropagation();

                // slideToggle للـ logout
                $('.logout-item').slideToggle(300, function() {
                    // بعد ما يخلص الـ slide، نقلب السهم
                    if ($('.logout-item').is(':visible')) {
                        $('#arrowIcon').addClass('rotated');
                    } else {
                        $('#arrowIcon').removeClass('rotated');
                    }
                });
            });

            // يختفي اللوغاوت لو ضغطت في أي مكان تاني
            $(document).on('click', function() {
                if ($('.logout-item').is(':visible')) {
                    $('.logout-item').slideUp(300);
                    $('#arrowIcon').removeClass('rotated');
                }
            });

            // منع اختفائه لو ضغطت على اللوغاوت نفسه
            $('.logout-item').on('click', function(e) {
                e.stopPropagation();
            });
</script>
   
@RenderSection("Scripts", required: false)