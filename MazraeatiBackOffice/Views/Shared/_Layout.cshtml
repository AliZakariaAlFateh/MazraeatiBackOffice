    <script>


        // ===== تحديد الصفحة النشطة =====
        // 1. الحصول على اسم الصفحة الحالية من الـ URL



          $(document).ready(function () {
        // ===== 1. فتح القوائم النشطة =====
        function openActiveMenus() {
            $('.menu-list li.open').each(function () {
                var $this = $(this);
                var $toggle = $this.find('> a.menu-toggle');
                var $submenu = $this.find('> ul.ml-menu');

                if ($toggle.length && $submenu.length) {
                    $toggle.addClass('toggled');
                    $submenu.css('display', 'block');
                }
            });
        }
        openActiveMenus();

        // ===== 2. Toggle القوائم =====
        $(".menu-toggle").click(function (e) {
            e.preventDefault();

            var $this = $(this);
            var $parentLi = $this.closest('li');
            var $submenu = $this.next();

            if ($submenu.is(':visible')) {
                $this.removeClass('toggled');
                $submenu.slideUp();
                $parentLi.removeClass('open');
            } else {
                // قفل كل القوائم المفتوحة
                $(".menu-list > li.open").each(function () {
                    var $li = $(this);
                    var $toggle = $li.find('> a.menu-toggle');
                    var $sub = $li.find('> ul.ml-menu');
                    $toggle.removeClass('toggled');
                    $sub.slideUp();
                    $li.removeClass('open');
                });

                // فتح القائمة الحالية
                $this.addClass('toggled');
                $submenu.slideDown();
                $parentLi.addClass('open');
            }
        });

        // ===== 3. عند الضغط على أي رابط =====
        $('.menu-list li a:not(.menu-toggle)').on('click', function () {
            // خلاص، الـ HTML هي اللي تحدد الـ active classes
            // مش بنضيف ولا بنشيل حاجة عشان الـ Reload هيحدد
        });
    });


        ///Side Bar
    const toggleBtn = document.getElementById("menu-toggle");
    const sidebar = document.getElementById("leftsidebar");
    const overlay = document.getElementById("sidebarOverlay");

    toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("active");
        overlay.classList.toggle("active");

        // تغيير الأيقونة
        this.innerHTML = sidebar.classList.contains("active")
            ? '<i class="zmdi zmdi-close"></i>'
            : '<i class="zmdi zmdi-menu"></i>';
    });




    // قفل عند الضغط خارجه
    overlay.addEventListener("click", function () {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        toggleBtn.innerHTML = '<i class="zmdi zmdi-menu"></i>';
    });

