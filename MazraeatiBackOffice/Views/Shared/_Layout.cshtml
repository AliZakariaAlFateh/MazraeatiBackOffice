<script>
    //this only code for Signal R may you can do modifiy on it ...
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("http://5.189.180.190/MazareatiAPI/farmHub") // Api for Prod
        //.withUrl("http://localhost:61366/farmHub") // Api for Dev
        .withAutomaticReconnect()
        .build();

    let notificationCount = 0;
    let notificationList = [];

    connection.on("FarmAdded", function (farm) {

        const message = `✅ تم اضافة مزرعة : ${farm.name ?? farm.Name}
        <br/><small>📍 ${farm.locationDesc ?? farm.LocationDesc}</small>`;

        notificationList.unshift(message);
        notificationCount++;

        updateNotificationUI();
        showToast(message); 
    });

    connection.start().catch(err => console.error(err));


    // ==========================
    // UI UPDATE
    // ==========================
    function updateNotificationUI() {

        const countElement = document.getElementById("notificationCount");
        const listElement = document.getElementById("notiItems");

        countElement.textContent = notificationCount;
        countElement.style.display = notificationCount > 0 ? "inline-block" : "none";

        listElement.innerHTML = "";

        if (notificationList.length === 0) {
            listElement.innerHTML = '<li class="noti-empty">لا توجد إشعارات</li>';
            return;
        }

        notificationList.forEach(n => {
            const li = document.createElement("li");
            li.innerHTML = n;
            listElement.appendChild(li);
        });
    }


    // ==========================
    // TOGGLE
    // ==========================
    function toggleNotifications() {

        const dropdown = document.getElementById("notificationList");

        dropdown.classList.toggle("active");

        // reset counter لما تفتح
        if (dropdown.classList.contains("active")) {
            notificationCount = 0;
            document.getElementById("notificationCount").style.display = "none";
        }
    }


    // ==========================
    // CLOSE WHEN CLICK OUTSIDE
    // ==========================
    document.addEventListener("click", function (e) {

        const wrapper = document.querySelector(".notification-wrapper");

        if (!wrapper.contains(e.target)) {
            document.getElementById("notificationList").classList.remove("active");
        }
    });


    // ==========================
    // SWEET TOAST 
    // ==========================
    function showToast(message) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            html: message,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });
    }



    </script>



    
    <script>
        ///Side Bar
    const toggleBtn = document.getElementById("menu-toggle");
    const sidebar = document.getElementById("leftsidebar");
    const overlay = document.getElementById("sidebarOverlay");

    toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("active");
        overlay.classList.toggle("active");

        // تغيير الأيقونة
        this.innerHTML = sidebar.classList.contains("active")
            ? '<i class="zmdi zmdi-close"></i>'
            : '<i class="zmdi zmdi-menu"></i>';
    });

    // قفل عند الضغط خارجه
    overlay.addEventListener("click", function () {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        toggleBtn.innerHTML = '<i class="zmdi zmdi-menu"></i>';
    });

    ///Side Bar
    $(".menu-toggle").click(function (e) {
        e.preventDefault();

        var $this = $(this);
        var $submenu = $this.next();

        $(".menu-toggle").not($this).removeClass("toggled");
        $(".menu-toggle").not($this).next().slideUp();

        $this.toggleClass("toggled");
        $submenu.slideToggle();
    });
    $(document).ready(function () {
        $('.select2').select2({
            placeholder: "اختر من القائمة",
            width: '100%',
            dir: "rtl",
            closeOnSelect: false
        });
    });
</script>
   
