    var userName = Context.Session.GetString("UserName") ?? "";
}

@functions {
    private bool IsActive(string controllerName, string actionName = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        if (string.IsNullOrEmpty(actionName))
        {
            return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);
    }

    // ===== دالة جديدة للتحقق من الـ Controller فقط مع تجاهل الـ Action =====
    private bool IsActiveController(string controllerName)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
    }
}
