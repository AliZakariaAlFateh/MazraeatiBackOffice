@using MazraeatiBackOffice.Models.LoyaltyPoints
@model LoyaltyRedeemRuleModel

<style>
    .form-group {
        font-size: 13px;
    }
</style>

@Html.HiddenFor(a => a.Id)
@Html.HiddenFor(a => a.CreatedDate)

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2>
                        <strong>@(Model.Id > 0 ? "تعديل" : "إضافة")</strong>
                        قاعدة صرف
                    </h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("Index")" class="btn btn-default btn-round">
                                <i class="fa fa-arrow-right"></i> العودة للقائمة
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger"><strong>خطأ!</strong> @TempData["ErrorMessage"]</div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="row clearfix">
                            <!-- عدد النقاط -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.Points)
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(a => a.Points, new { @class = "form-control", type = "number", min = "1", required = "required" })
                                    @Html.ValidationMessageFor(a => a.Points, "", new { @style = "color:red;font-size:10px" })
                                    <small class="text-muted">عدد النقاط المطلوبة للخصم</small>
                                </div>
                            </div>

                            <!-- قيمة الخصم -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.DiscountAmount)
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(a => a.DiscountAmount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                                    @Html.ValidationMessageFor(a => a.DiscountAmount, "", new { @style = "color:red;font-size:10px" })
                                    <small class="text-muted">قيمة الخصم بالدينار</small>
                                </div>
                            </div>

                            <!-- نشط -->
                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.IsActive)
                                    <br />
                                    @Html.CheckBoxFor(a => a.IsActive, new { @class = "form-control", style = "margin-top: 10px; width:20px !important; height:20px;" })
                                </div>
                            </div>

                            <!-- أزرار -->
                            <div class="col-sm-12" style="margin-top:20px;">
                                <button type="submit" class="btn btn-primary btn-round">
                                    <i class="fa fa-save"></i> @(Model.Id > 0 ? "تحديث" : "حفظ")
                                </button>
                                <button type="button" onclick="window.location.href='@Url.Action("Index")'" class="btn btn-default btn-round btn-simple">
                                    <i class="fa fa-arrow-right"></i> رجوع
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}