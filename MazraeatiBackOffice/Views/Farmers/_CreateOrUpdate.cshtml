@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    $(document).ready(function () {

        //BaseUrl_Pro
        //BaseUrl_Dev
        // الحصول على القيم من السيرفر (ViewBag)

        var selectedCityId = $('#CityId').val(); // أو من ViewBag إذا فضلت
        var selectedRegionId = '@ViewBag.RegionId';

        // 1. تعريف حدث تغيير المدينة
        $("#CityId").on("change", function () {
            var cityId = $(this).val();
            var $region = $("#RegionId");

            // تنظيف القائمة وتعطيلها مؤقتاً
            $region.empty()
                .append('<option selected disabled>--الرجاء اختيار المنطقة--</option>')
                .prop("disabled", true)
                //.selectpicker('refresh');
                $region.trigger('change');
            if (!cityId || cityId === "0") return;

            // طلب البيانات من السيرفر
            $.ajax({
                url: `${BaseUrl_Pro}/Farmers/GetRegionsByCityId`,
                type: 'GET',
                data: { cityId: cityId },
                success: function (data) {
                    $region.empty().append($('<option/>', {
                        text: '--الرجاء اختيار المنطقة--',
                        disabled: true,
                        selected: true
                    }));

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            var $opt = $('<option/>', {
                                value: item.id,
                                text: item.descAr
                            });
                            // إضافة الـ Data Attributes لو محتاجها
                            $opt.attr("data-descar", item.descAr);
                            $opt.attr("data-descen", item.descEn);
                            $region.append($opt);
                        });

                        $region.prop("disabled", false);
                    }

                    // تحديث مكتبة الـ SelectPicker
                    //$region.selectpicker('refresh');
                    $region.trigger('change');
                    // --- الجزء المهم جداً لضبط الاختيار القديم ---
                    if (selectedRegionId && selectedRegionId !== "0") {
                        $region.val(selectedRegionId);
                        //$region.selectpicker('refresh');
                        $region.trigger('change');
                        // تصفير المتغير عشان ميعلقش لو غيرت المدينة يدوياً بعد كدة
                        selectedRegionId = "0";
                    }
                },
                error: function () {
                    console.error("خطأ في جلب المناطق");
                }
            });
        });

        // 2. تشغيل الكود تلقائياً عند تحميل الصفحة إذا كانت المدينة مختارة
        if (selectedCityId && selectedCityId !== "0") {
            $("#CityId").trigger('change');
        }


        function initPhone(inputId) {

            var input = document.querySelector(inputId);

            var iti = window.intlTelInput(input, {

                initialCountry: "auto",

                geoIpLookup: function (callback) {
                    $.get("https://ipapi.co/json/", function (data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function () {
                        callback("eg"); // fallback
                    });
                },

                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],

                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });

            // لو فيه رقم جاى من DB
            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }

            return iti;
        }

        // Initialize الاتنين
        var iti1 = initPhone("#phone1");

        // ============================
        // Submit
        // ============================
        $("form").on("submit", function () {

            // تأكد إن utils اتحمل
            if (!iti1.isValidNumber()) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'رقم الموبايل  غير صحيح'
                });
                return false;
            }

            $("#phone1").val(iti1.getNumber());
        });


    });

</script>