                        <option value="5x5" selected="@(Model.FootballPitchType == "5x5")">5×5</option>
                        <option value="7x7" selected="@(Model.FootballPitchType == "7x7")">7×7</option>
                        <option value="11x11" selected="@(Model.FootballPitchType == "11x11")">11×11</option>
