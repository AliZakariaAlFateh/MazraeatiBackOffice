                    <input type="checkbox" name="FootballIsIndoor" value="true" class="form-control" style="width:20px;height:20px;margin-top:5px;" @(Model.FootballIsIndoor == true ? "checked" : "") />
                    <input type="hidden" name="FootballIsIndoor" value="false" />
