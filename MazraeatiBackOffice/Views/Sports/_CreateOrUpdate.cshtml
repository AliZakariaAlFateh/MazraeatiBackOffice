@using MazraeatiBackOffice.Configuration
@model SportModel

@{
    ViewBag.Title = Model.Id > 0 ? "تعديل نشاط رياضى" : "إضافة نشاط رياضى جديد";
    ViewBag.activePage = "الأنشطة الرياضية";
    int selectedSportTypeId = ViewBag.SelectedSportTypeId ?? 0;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<style>
    .form-group {
        font-size: 13px;
    }

    .delete-image-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background-color: rgba(255,0,0,0.7);
        color: white;
        border: none;
        border-radius: 50%;
        width: 25px;
        height: 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        font-weight: bold;
        font-size: 0.8em;
    }

    .sport-image-item.removing, .sport-video-item.removing {
        opacity: 0;
        transition: opacity 0.3s ease-out;
    }

    .table input {
        min-width: 90px;
    }

    .text-center td, .text-center th {
        vertical-align: middle;
    }
</style>

<link href="~/assets/css/style_main_mahjouz.css" rel="stylesheet" />

@Html.HiddenFor(a => a.Id)
