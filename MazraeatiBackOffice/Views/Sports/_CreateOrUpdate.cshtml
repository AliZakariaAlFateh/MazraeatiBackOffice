    // ===== إضافة صف أسعار =====
        // ===== إضافة صف أسعار جديد =====
    var priceIndex = @Model?.PriceList?.Count ?? 0;

    function addPriceRow() {
        var container = $('#priceListContainer');
        var table = container.find('table');

        if (table.length === 0) {
            container.html(`
                <div style="overflow-x:auto">
                    <table class="table table-bordered table-striped table-hover text-center" id="priceTable">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th style="width:8%">اليوم</th>
                                <th style="width:12%">عدد الأشخاص</th>
                                <th style="width:14%">سعر الساعة</th>
                                <th style="width:14%">سعر الذروة</th>
                                <th style="width:12%">بداية الذروة</th>
                                <th style="width:12%">نهاية الذروة</th>
                                <th style="width:14%">سعر العرض</th>
                                <th style="width:10%">حذف</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            `);
            table = container.find('table');
        }

        var tbody = table.find('tbody');
        var row = `
            <tr>
                <td>
                    <input type="hidden" name="PriceList[${priceIndex}].Id" value="0" />
                    <input type="hidden" name="PriceList[${priceIndex}].SportId" value="0" />
                    <select name="PriceList[${priceIndex}].Day" class="form-control">
                        <option value="1">الأحد</option>
                        <option value="2">الإثنين</option>
                        <option value="3">الثلاثاء</option>
                        <option value="4">الأربعاء</option>
                        <option value="5">الخميس</option>
                        <option value="6">الجمعة</option>
                        <option value="7">السبت</option>
                    </select>
                </td>
                <td><input type="number" name="PriceList[${priceIndex}].Person" class="form-control" min="1" /></td>
                <td><input type="number" step="0.01" name="PriceList[${priceIndex}].HourlyPrice" class="form-control" placeholder="السعر" required /></td>
                <td><input type="number" step="0.01" name="PriceList[${priceIndex}].PeakHourlyPrice" class="form-control" placeholder="سعر الذروة" /></td>
                <td><input type="time" name="PriceList[${priceIndex}].PeakStartTime" class="form-control" /></td>
                <td><input type="time" name="PriceList[${priceIndex}].PeakEndTime" class="form-control" /></td>
                <td><input type="number" step="0.01" name="PriceList[${priceIndex}].OfferHourlyPrice" class="form-control" placeholder="سعر العرض" /></td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="removePriceRow(this)"><i class="fa fa-trash"></i></button></td>
            </tr>
        `;
        tbody.append(row);
        priceIndex++;
    }

    // ===== حذف صف أسعار =====
    function removePriceRow(btn) {
        if (confirm('هل أنت متأكد من حذف هذا السعر؟')) {
            $(btn).closest('tr').remove();
        }
    }
