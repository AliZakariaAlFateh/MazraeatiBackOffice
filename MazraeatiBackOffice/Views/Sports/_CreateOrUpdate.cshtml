                                                {
                                                    <tr style="background:#e9f7ef;font-weight:bold">
                                                        <td colspan="7">
                                                            عدد الاشخاص المسموح بهم:
                                                            <div class="col-sm-3" style="display: inline-flex;">
                                                                <div class="form-group">
                                                                    @Html.TextBoxFor(a => Model.PriceList[i].Person, new { @class = "form-control", type = "number", id = "person_" + Model.PriceList[i].Day })
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <a href="javascript:DeletePriceList_Full(@Model.PriceList[i].SportId);"
                                                               class="btn btn-danger btn-sm">
                                                                حذف
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }

                                                <tr>
                                                    <!-- اليوم -->
                                                    <td>
                                                        @switch (Model.PriceList[i].Day)
                                                        {
                                                            case 1:
                                                                @("الاحد")
                                                                ; break;
                                                            case 2:

                                                                @("الاثنين")
                                                                ; break;
                                                            case 3:

                                                                @("الثلاثاء")
                                                                ; break;
                                                            case 4:

                                                                @("الاربعاء")
                                                                ; break;
                                                            case 5:

                                                                @("الخميس")
                                                                ; break;
                                                            case 6:

                                                                @("الجمعة")
                                                                ; break;
                                                            case 7:

                                                                @("السبت")
                                                                ; break;
                                                        }
                                                    </td>

                                                    @Html.HiddenFor(a => Model.PriceList[i].Id)
                                                    @Html.HiddenFor(a => Model.PriceList[i].Day)
                                                    @Html.HiddenFor(a => Model.PriceList[i].SportId)
                                                    @* ===== التعديل هنا ===== *@
                                                    @* بدل ما نخبي الـ Person، هنستخدم JavaScript عشان ننقل القيمة *@
                                                    @Html.HiddenFor(a => Model.PriceList[i].Person, new { @class = "person-hidden", data_day = Model.PriceList[i].Day })

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].HourlyPrice, new { @class = "form-control", type = "number" })
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].PeakHourlyPrice, new { @class = "form-control", type = "number" })
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].PeakStartTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].PeakEndTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].OfferHourlyPrice, new { @class = "form-control", type = "number" })
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(a => Model.PriceList[i].MinBookingHours, new { @class = "form-control", type = "number" })
                                                    </td>
                                                </tr>
                                            }



                                        </tbody>
                                    </table>

                                </div>
                            }

                            @* For Price Table *@




