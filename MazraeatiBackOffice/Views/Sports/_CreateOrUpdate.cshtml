                            <div class="col-sm-12"><h5 style="text-decoration:underline">الخدمات الإضافية</h5></div>

                            <div class="row clearfix">
                                @for (int i = 0; i < Model.AdditionalServices.Count; i++)
                                {
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            @Html.HiddenFor(a => a.AdditionalServices[i].ServiceId)
                                            @Html.HiddenFor(a => a.AdditionalServices[i].ServiceText)
                                            @Html.DisplayFor(a => a.AdditionalServices[i].ServiceText)
                                            <br />
                                            @Html.CheckBoxFor(a => a.AdditionalServices[i].IsCheck, new { @class = "form-control", style = "width:20px;height:20px;margin-top:5px;" })
                                        </div>
                                    </div>
                                }
                            </div>


                            <!-- ===== ميزات الأمان (مثل Farmer ExtraFeature) ===== -->
                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>
                            <div class="col-sm-12"><h5 style="text-decoration:underline">ميزات الأمان</h5></div>

                            <div class="row clearfix">
                                @for (int i = 0; i < Model.SafetyFeatures.Count; i++)
                                {
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            @Html.HiddenFor(a => a.SafetyFeatures[i].Id)
                                            @Html.HiddenFor(a => a.SafetyFeatures[i].TypeId)
                                            @Html.HiddenFor(a => a.SafetyFeatures[i].FeatureText)
                                            @Html.DisplayFor(a => a.SafetyFeatures[i].FeatureText)
                                            <br />
                                            @Html.CheckBoxFor(a => a.SafetyFeatures[i].IsCheck, new { @class = "form-control", style = "width:20px;height:20px;margin-top:5px;" })
                                            @Html.TextBoxFor(a => a.SafetyFeatures[i].DescriptionAr, new { @class = "form-control", @maxlength = 100, @placeholder = "الوصف بالعربي" })
                                            @Html.TextBoxFor(a => a.SafetyFeatures[i].DescriptionEn, new { @class = "form-control", @maxlength = 100, @placeholder = "الوصف بالإنجليزي" })
                                        </div>
                                    </div>
                                }
                            </div>



                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>
                            <div class="col-sm-12"><h5 style="text-decoration:underline">الأسعار</h5></div>
                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>

                            @if (Model?.PriceList?.Count() == 0)
                            {    <!--onclick="window.location.href='Url.Content("~/Sports/SportPriceList?sportId=")Model.Id'"-->
                                <button type="button"
                                        onclick="window.location.href='@Url.Action("SportPriceList", "Sports", new { sportId = Model.Id, SportTypeId = Model.SportTypeId })'"
                                        class="btn btn-primary btn-round mb-3">
                                    اضافة اسعار جديدة
                                </button>
                            }

                            @if (Model?.PriceList?.Count() > 0)
                            {
                                <div style="overflow-x:auto">

                                    <table class="table table-bordered table-striped table-hover text-center">

                                        <thead class="bg-Secondary text-white">
                                            <tr>
                                                <th style="width:8%">اليوم</th>
                                                <th style="width:14%">سعر الساعة</th>
                                                <th style="width:14%">سعر الذروة</th>
                                                <th style="width:12%">بداية الذروة</th>
                                                <th style="width:12%">نهاية الذروة</th>
                                                <th style="width:14%">سعر العرض</th>
                                                <th style="width:14%">أقل عدد ساعات مسموح به</th>
                                                <th style="width:14%">حذف</th>
                                            </tr>
                                        </thead>

                                        <tbody>


                                            @for (int i = 0; i < Model.PriceList.OrderBy(c => c.Person).ThenBy(n => n.Day).Count(); i++)
                                            {
                                                //Title for All Person
