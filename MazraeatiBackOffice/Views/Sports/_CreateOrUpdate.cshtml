                                                <tr>
                                                    <th style="width:8%">اليوم</th>
                                                    <th style="width:12%">عدد الأشخاص</th>
                                                    <th style="width:14%">سعر الساعة</th>
                                                    <th style="width:14%">سعر الذروة</th>
                                                    <th style="width:12%">بداية الذروة</th>
                                                    <th style="width:12%">نهاية الذروة</th>
                                                    <th style="width:14%">سعر العرض</th>
                                                    <th style="width:10%">حذف</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.PriceList.Count; i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="hidden" name="PriceList[@i].Id" value="@Model.PriceList[i].Id" />
                                                            <input type="hidden" name="PriceList[@i].SportId" value="@Model.PriceList[i].SportId" />
                                                            <select name="PriceList[@i].Day" class="form-control">
                                                                <option value="1" selected="@(Model.PriceList[i].Day == 1)">الأحد</option>
                                                                <option value="2" selected="@(Model.PriceList[i].Day == 2)">الإثنين</option>
                                                                <option value="3" selected="@(Model.PriceList[i].Day == 3)">الثلاثاء</option>
                                                                <option value="4" selected="@(Model.PriceList[i].Day == 4)">الأربعاء</option>
                                                                <option value="5" selected="@(Model.PriceList[i].Day == 5)">الخميس</option>
                                                                <option value="6" selected="@(Model.PriceList[i].Day == 6)">الجمعة</option>
                                                                <option value="7" selected="@(Model.PriceList[i].Day == 7)">السبت</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <input type="number" name="PriceList[@i].Person" value="@Model.PriceList[i].Person" class="form-control" min="1" />
                                                        </td>
                                                        <td>
                                                            <input type="number" step="0.01" name="PriceList[@i].HourlyPrice" value="@Model.PriceList[i].HourlyPrice" class="form-control" placeholder="السعر" required />
                                                        </td>
                                                        <td>
                                                            <input type="number" step="0.01" name="PriceList[@i].PeakHourlyPrice" value="@Model.PriceList[i].PeakHourlyPrice" class="form-control" placeholder="سعر الذروة" />
                                                        </td>
                                                        <td>
                                                            <input type="time" name="PriceList[@i].PeakStartTime" value="@(Model.PriceList[i].PeakStartTime?.ToString(@"hh\:mm"))" class="form-control" />
                                                        </td>
                                                        <td>
                                                            <input type="time" name="PriceList[@i].PeakEndTime" value="@(Model.PriceList[i].PeakEndTime?.ToString(@"hh\:mm"))" class="form-control" />
                                                        </td>
                                                        <td>
                                                            <input type="number" step="0.01" name="PriceList[@i].OfferHourlyPrice" value="@Model.PriceList[i].OfferHourlyPrice" class="form-control" placeholder="سعر العرض" />
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-danger btn-sm" onclick="removePriceRow(this)">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div> *@






                            <!-- ===== الصور (مثل Farmer) ===== -->
                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>
                            <div class="col-sm-12"><h5 style="text-decoration:underline">إضافة صور</h5></div>

                            <div class="col-sm-12">
                                @Html.TextBoxFor(model => model.Images, new { type = "file", multiple = "", accept = "image/*" })
                            </div>

                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>

                            <div class="col-sm-12">
                                <div id="imagePreviews" class="sport-image-container"></div>
                            </div>

                            @if (Model.SportImages != null && Model.SportImages.Any())
                            {
                                <div class="col-sm-12" style="margin-bottom:20px">
                                    <h5>الصور الحالية</h5>
                                    <div class="sport-image-container">
                                        @foreach (var image in Model.SportImages)
                                        {
                                            <div class="sport-image-item" style="display:inline-block;margin:5px;position:relative;">
                                                <img src="~/Images/@image.Url" alt="صورة" style="width:150px;height:100px;object-fit:cover;border-radius:5px;" />
                                                <button type="button" class="delete-image-btn" onclick="deleteSportImage(@image.Id)"><i class="fa fa-times"></i></button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- ===== الفيديوهات (مثل Farmer) ===== -->
                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>
                            <div class="col-sm-12"><h5 style="text-decoration:underline">إضافة فيديوهات</h5></div>

                            <div class="col-sm-12">
                                @Html.TextBoxFor(model => model.Videos, new { type = "file", multiple = "", accept = "video/*" })
                            </div>

                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>

                            <div class="col-sm-12">
                                <div id="videoPreviews" class="sport-video-container"></div>
                            </div>

                            @if (Model.SportVideos != null && Model.SportVideos.Any())
                            {
                                <div class="col-sm-12" style="margin-bottom:20px">
                                    <h5>الفيديوهات الحالية</h5>
                                    <div class="sport-video-container">
                                        @foreach (var video in Model.SportVideos)
                                        {
                                            <div class="sport-video-item" style="display:inline-block;margin:5px;position:relative;">
                                                <video controls style="width:200px;border-radius:5px;"><source src="~/Videos/@video.Url"></video>
                                                <button type="button" class="delete-image-btn" onclick="deleteSportVideo(@video.Id)"><i class="fa fa-times"></i></button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- ===== أزرار ===== -->
                            <div class="col-sm-12" style="margin-bottom:20px">&nbsp;</div>

                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary btn-round"><i class="fa fa-save"></i> @(Model.Id > 0 ? "تحديث" : "حفظ")</button>
                                <a href="@Url.Action("Index")" class="btn btn-default btn-round"><i class="fa fa-arrow-right"></i> رجوع</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

