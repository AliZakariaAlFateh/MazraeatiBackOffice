@model SportReservationModel

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<style>
    .form-group {
        font-size: 13px;
    }

    .calculation-box {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 10px;
    }

        .calculation-box .row {
            margin-bottom: 5px;
        }

        .calculation-box .label {
            font-weight: bold;
            color: #333;
        }

        .calculation-box .value {
            color: #007bff;
            font-weight: bold;
        }

        .calculation-box .profit {
            color: #28a745;
        }

        .calculation-box .remain {
            color: #dc3545;
        }

    .points-box {
        background: #f8f9fa;
        padding: 10px 15px;
        border-radius: 5px;
        border: 1px solid #ffc107;
        margin: 10px 0;
    }

        .points-box .points-number {
            font-size: 24px;
            font-weight: bold;
            color: #28a745;
        }

    .discount-result {
        background: #e8f4fd;
        padding: 10px 15px;
        border-radius: 5px;
        border: 1px solid #b8daff;
        margin: 10px 0;
    }

    .discount-amount {
        color: #dc3545;
        font-weight: bold;
        font-size: 18px;
    }

    .new-total {
        color: #28a745;
        font-weight: bold;
        font-size: 18px;
    }
    /* إضافة في الـ <style> */
.input-group .form-control {
    border-radius: 4px 0 0 4px;
}

.input-group .btn {
    border-radius: 0 4px 4px 0;
    border-left: none;
}

.input-group .btn:hover {
    background-color: #f8f9fa;
}

    #clearReservationAmt{
        height: 10px;
        border-radius: 50%;
        position: absolute;
        left: 10px;
    }
</style>

@Html.HiddenFor(a => a.Id)
@Html.HiddenFor(a => a.MobileOwnerAppUser)
@Html.HiddenFor(a => a.TotalHours)

<!-- ===== حقول مخفية للـ JavaScript ===== -->
<input type="hidden" id="RedeemRulesData" value='@Html.Raw(Json.Serialize(ViewBag.RedeemRules))' />
<input type="hidden" id="CustomerPointsData" value="@Model.CustomerAvailablePoints" />
<input type="hidden" id="CustomerIdData" value="@Model.CustomerId" />

<!-- ===== Hidden field للمبلغ الأصلي ===== -->
<input type="hidden" id="ReservationAmtOriginal" value="@Model.ReservationAmt" />

@if (ViewData.ModelState.Any(m => m.Value.Errors.Any()))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>خطأ!</strong> يرجى تصحيح الأخطاء التالية:
        <ul>
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row clearfix">
    <!-- ===== نوع الرياضة ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.SportTypeDesc)
            <select class="form-control select2" name="SportTypeId" id="SportTypeId"
                    data-url="@Url.Action("GetSportsByType", "SportReservations")">
                <option value="">-- اختر القسم الرياضي --</option>
                @foreach (var item in ViewBag.SportTypes)
                {
                    <option selected="@(item.Id == Model.SportTypeId)" value="@item.Id">@item.NameAr</option>
                }
            </select>
            @Html.ValidationMessageFor(a => a.SportTypeId, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== القسم الرياضي ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.SportDesc)
            <select class="form-control select2" name="SportId" id="SportId" data-selected-id="@Model.SportId">
                <option value="">-- اختر العقار --</option>
                @if (ViewBag.Sports != null)
                {
                    var sports = ViewBag.Sports as List<Sport>;
                    if (sports != null)
                    {
                        foreach (var sport in sports)
                        {
                            <option value="@sport.Id" selected="@(sport.Id == Model.SportId)">@sport.NameAr</option>
                        }
                    }
                }
            </select>
            @Html.ValidationMessageFor(a => a.SportId, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== العميل ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.CustomerDesc)
            <select class="form-control select2" name="CustomerId" id="CustomerId"
                    data-points-url="@Url.Action("GetCustomerPoints", "LoyaltyTransactions")"
                    data-validate-url="@Url.Action("ValidateRedeemPoints", "SportReservations")">
                <option value="">-- اختر العميل --</option>
                @if (Model.Customers != null)
                {
                    foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id"
                                data-customername="@customer.FullName"
                                data-customerphone="@customer.MobileNumber"
                                selected="@(customer.Id == Model.CustomerId)">
                            @customer.FullName  /  @customer.MobileNumber
                        </option>
                    }
                }
            </select>
            @Html.ValidationMessageFor(a => a.CustomerId, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== اسم العميل ===== -->
    <div class="col-sm-6">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.CustomerName)
            @Html.TextBoxFor(a => a.CustomerName, new { @class = "form-control", @autocomplete = "off", @id = "CustomerName", @readonly = "readonly" })
            @Html.ValidationMessageFor(a => a.CustomerName, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== رقم جوال العميل ===== -->
    <div class="col-sm-6">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.CustMobNum)
            @Html.TextBoxFor(a => a.CustMobNum, new { @class = "form-control", @autocomplete = "off", id = "CustomerPhone", dir = "ltr" })
            @Html.ValidationMessageFor(a => a.CustMobNum, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== تاريخ الحجز ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.ReservationDate)
            @Html.TextBoxFor(a => a.ReservationDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", @id = "ReservationDate" })
            @Html.ValidationMessageFor(a => a.ReservationDate, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== وقت البداية ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.StartTime)
            @Html.TextBoxFor(a => a.StartTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
            @Html.ValidationMessageFor(a => a.StartTime, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== وقت النهاية ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.EndTime)
            @Html.TextBoxFor(a => a.EndTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
            @Html.ValidationMessageFor(a => a.EndTime, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== عدد الأشخاص ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.PersonCount)
            @Html.TextBoxFor(a => a.PersonCount, new { @class = "form-control", type = "number", min = "1" })
            @Html.ValidationMessageFor(a => a.PersonCount, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== تكلفة الحجز على محجوز ===== -->
    <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.CostReservationAmtOnMahjouz)
            @Html.TextBoxFor(a => a.CostReservationAmtOnMahjouz, new { @class = "form-control cost-amount", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(a => a.CostReservationAmtOnMahjouz, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div>

    <!-- ===== المبلغ الكلي ===== -->
    @* <div class="col-sm-4">
        <div class="form-group">
            @Html.DisplayNameFor(a => a.ReservationAmt)
            @Html.TextBoxFor(a => a.ReservationAmt, new { @class = "form-control reservation-amt", id = "ReservationAmt", type = "number" })
            @Html.ValidationMessageFor(a => a.ReservationAmt, "", new { @style = "color:red;font-size:10px" })
        </div>
    </div> *@
