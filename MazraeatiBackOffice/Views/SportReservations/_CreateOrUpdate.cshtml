<!-- ===== JavaScript (القديم + الجديد) ===== -->
<script>
    $(document).ready(function() {
        // ============================================================
        // الكود القديم (زي ما هو)
        // ============================================================

        var todayStr = new Date().toISOString().split('T')[0];
        var $input = $('#ReservationDate');
        $input.attr({ min: todayStr });
        if (!$input.val()) $input.val(todayStr);
        $input.attr('readonly', false)
            .on('keydown paste drop input', function(e) {
                e.preventDefault();
                return false;
            });
        $input.on('click', function() {
            try { this.showPicker && this.showPicker(); } catch(e) {}
            this.blur();
        });
        $input.on('change', function() {
            var val = $(this).val();
            if (!val || val < todayStr) {
                $(this).val(todayStr);
            }
        });

        // ===== تعبئة اسم العميل ورقمه =====
        $("#CustomerId").on("change", function() {
            var selectedOption = $(this).find('option:selected');
            var Cname = selectedOption.data('customername');
            var CPhone = selectedOption.data('customerphone');
            $("#CustomerName").val(Cname);
            $("#CustomerPhone").val(CPhone);

            // ===== عند تغيير العميل، نجيب نقاطه =====
            var customerId = $(this).val();
            if (customerId) {
                $.ajax({
                    url: '@Url.Action("GetCustomerPoints", "LoyaltyTransactions")',
                    type: 'GET',
                    data: { customerId: customerId },
                    success: function(data) {
                        customerPoints = data.points || 0;
                        $('#customerPointsDisplay').text(customerPoints);
                        $('#maxPointsDisplay').text(customerPoints);
                        $('#redeemPoints').attr('max', customerPoints);
                        $('#pointsStatusBadge')
                            .text(customerPoints > 0 ? 'متاحة للخصم' : 'لا توجد نقاط')
                            .removeClass(customerPoints > 0 ? 'badge-secondary' : 'badge-success')
                            .addClass(customerPoints > 0 ? 'badge-success' : 'badge-secondary');
                        updateAll();
                    }
                });
            }
        });

        // ===== تهيئة intl-tel-input =====
        function initPhone(inputId) {
            var input = document.querySelector(inputId);
            var iti = window.intlTelInput(input, {
                initialCountry: "auto",
                geoIpLookup: function(callback) {
                    $.get("https://ipapi.co/json/", function(data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function() {
                        callback("eg");
                    });
                },
                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });
            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }
            return iti;
        }

        var iti1 = initPhone("#CustomerPhone");

        $("form").on("submit", function() {
            if (!iti1.isValidNumber()) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'رقم الموبايل غير صحيح'
                });
                return false;
            }
            $("#CustomerPhone").val(iti1.getNumber());
        });

        // ===== حساب الربح والمتبقي (القديم) =====
        function calculateValues() {
            var cost = parseFloat($('.cost-amount').val()) || 0;
            var total = parseFloat($('.reservation-amt').val()) || 0;
            var deposit = parseFloat($('.deposit-amt').val()) || 0;
            var profit = total - cost;
            var remain = total - deposit;
            $('#netProfit').val(profit);
            $('#reservationRemain').val(remain);
        }

        $('.cost-amount, .reservation-amt, .deposit-amt').on('input', function() {
            calculateValues();
        });

        // ===== جلب الأقسام حسب نوع الرياضة (القديم) =====
        $('#SportTypeId').change(function() {
            var sportTypeId = $(this).val();
            var selectedSportId = @Model.SportId;
            if (sportTypeId) {
                $.ajax({
                    url: '@Url.Action("GetSportsByType", "SportReservations")',
                    type: 'GET',
                    data: { sportTypeId: sportTypeId },
                    success: function(data) {
                        var select = $('#SportId');
                        select.empty();
                        select.append('<option value="">-- اختر القسم --</option>');
                        $.each(data, function(index, sport) {
                            var selected = (sport.id == selectedSportId) ? 'selected' : '';
                            select.append('<option value="' + sport.id + '" ' + selected + '>' + sport.nameAr + '</option>');
                        });
                    }
                });
            } else {
                $('#SportId').empty().append('<option value="">-- اختر القسم --</option>');
            }
        });

        // ============================================================
        // الكود الجديد (نظام النقاط)
        // ============================================================

        var redeemRules = @Html.Raw(Json.Serialize(ViewBag.RedeemRules));
        var customerPoints = @Model.CustomerAvailablePoints;
        var isUpdating = false;

        // حفظ المبلغ الأصلي
        $('#ReservationAmtOriginal').val($('#ReservationAmt').val());

        // حساب الخصم
        function calculateDiscount(points) {
            if (!redeemRules || redeemRules.length === 0) {
                return { discount: 0, rule: null, canRedeem: false };
            }
            var sortedRules = redeemRules.slice().sort(function(a, b) {
                return b.points - a.points;
            });
            for (var i = 0; i < sortedRules.length; i++) {
                if (points >= sortedRules[i].points) {
                    var ratio = Math.floor(points / sortedRules[i].points);
                    var discount = ratio * sortedRules[i].discountAmount;
                    return { discount: discount, rule: sortedRules[i], canRedeem: true };
                }
            }
            return { discount: 0, rule: null, canRedeem: false };
        }

        // تحديث الحسابات
        function updateCalculations(pointsToRedeem) {
            if (isUpdating) return;
            isUpdating = true;

            var usePoints = $('#usePointsCheck').is(':checked');
            var points = pointsToRedeem || parseInt($('#redeemPoints').val()) || 0;

            if (!usePoints || points <= 0) {
                $('#discountResultsSection').hide();
                var total = parseFloat($('#ReservationAmtOriginal').val()) || 0;
                $('#ReservationAmt').val(Number(total));
                isUpdating = false;
                calculateValues();
                return;
            }

            if (points > customerPoints) {
                points = customerPoints;
                $('#redeemPoints').val(points);
            }

            var result = calculateDiscount(points);
            var discount = result.discount;
            var totalAmount = parseFloat($('#ReservationAmtOriginal').val()) || 0;
            var newTotal = totalAmount - discount;
            var remainingPoints = customerPoints - points;

            if (result.canRedeem && discount > 0) {

                $('#discountResultsSection').show();
                $('#discountAmountDisplay').text(discount + ' دينار');
                $('#remainingPointsDisplay').text(remainingPoints + ' نقطة');
                $('#newTotalDisplay').text(newTotal + ' دينار');
                if (result.rule) {
                    $('#discountRuleDisplay').text(result.rule.points + ' نقطة = ' + result.rule.discountAmount + ' دينار');
                }
                $('#ReservationAmt').val(Number(newTotal));
                $('#pointsValidationMessage').hide();
            } else {
                $('#discountResultsSection').hide();
                var total = parseFloat($('#ReservationAmtOriginal').val()) || 0;
                $('#ReservationAmt').val(Number(total));
            }

            calculateValues();
            isUpdating = false;
        }

        // التحقق من النقاط
        function validatePoints(points, customerId) {
            if (!customerId || points <= 0) {
                $('#pointsValidationMessage').hide();
                return;
            }
            $.ajax({
                url: '@Url.Action("ValidateRedeemPoints", "SportReservations")',
                type: 'GET',
                data: { customerId: customerId, points: points },
                success: function(data) {
                    if (data.success && data.canRedeem) {
                        $('#pointsValidationMessage').hide();
                        updateCalculations(points);
                    } else {
                        $('#pointsValidationMessage')
                            .text(data.message || 'لا يمكن استخدام هذا العدد من النقاط')
                            .show();
                        $('#discountResultsSection').hide();
                    }
                },
                error: function() {
                    $('#pointsValidationMessage').text('حدث خطأ في الاتصال').show();
                }
            });
        }

        function updateAll() {
            var usePoints = $('#usePointsCheck').is(':checked');
            var points = parseInt($('#redeemPoints').val()) || 0;
            if (usePoints && points > 0) {
                validatePoints(points, $('#CustomerId').val());
            } else {
                $('#discountResultsSection').hide();
                $('#pointsValidationMessage').hide();
                var total = parseFloat($('#ReservationAmtOriginal').val()) || 0;
                $('#ReservationAmt').val(Number(total));
                calculateValues();
            }
        }

        // ===== أحداث النقاط (جديدة) =====
        $('#usePointsCheck').change(function() {
            if ($(this).is(':checked')) {
                $('#pointsRedeemSection').show();
                $('#redeemPoints').val(0);
                updateAll();
            } else {
                $('#pointsRedeemSection').hide();
                $('#redeemPoints').val(0);
                $('#discountResultsSection').hide();
                $('#pointsValidationMessage').hide();
                var total = parseFloat($('#ReservationAmtOriginal').val()) || 0;
                $('#ReservationAmt').val(Number(total));
                calculateValues();
            }
        });

        $('#redeemPoints').on('input', function() {
            var points = parseInt($(this).val()) || 0;
            if (points > customerPoints) {
                $(this).val(customerPoints);
            }
            updateAll();
        });

        $('#ReservationAmt').on('input', function() {
            if (isUpdating) return;
            var val = parseFloat($(this).val()) || 0;
            if (val > 0) {
                $('#ReservationAmtOriginal').val(val);
            }
            updateAll();
        });

        // ===== تهيئة أولية =====
        calculateValues();
        updateAll();
    });
</script> *@





