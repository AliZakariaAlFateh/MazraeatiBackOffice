                <button type="button" class="btn btn-outline-secondary" id="clearReservationAmt" title="مسح القيمة">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(a => a.ReservationAmt, "", new { @style = "color:red;font-size:10px" })
