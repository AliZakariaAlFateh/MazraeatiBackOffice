        @Html.CheckBoxFor(a => a.IsReceiveCommession, new { @class = "form-control", @style = "margin-top: 10px; width:5% !important" })
    </div>
</div>

<!-- ===== إضافة الـ JS الخارجي ===== -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script src="~/assets/js/sport/sportreservation.js"></script>
<script>
    $(document).ready(function() {
        // تهيئة النظام
        SportReservation.init({
            redeemRules: JSON.parse($('#RedeemRulesData').val() || '[]'),
            customerPoints: parseFloat($('#CustomerPointsData').val()) || 0,
            customerId: $('#CustomerIdData').val() || null
        });

        // تهيئة intl-tel-input
        function initPhone(inputId) {
            var input = document.querySelector(inputId);
            var iti = window.intlTelInput(input, {
                initialCountry: "auto",
                geoIpLookup: function(callback) {
                    $.get("https://ipapi.co/json/", function(data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function() {
                        callback("eg");
                    });
                },
                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });
            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }
            return iti;
        }

        var iti1 = initPhone("#CustomerPhone");

        $("form").on("submit", function() {
            if (!iti1.isValidNumber()) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'رقم الموبايل غير صحيح'
                });
                return false;
            }
            $("#CustomerPhone").val(iti1.getNumber());
        });
    });
</script>

