@model SportReservationModel

@{
    ViewBag.Title = "تعديل حجز";
    ViewBag.activePage = "الحجوزات الرياضية";
}

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2><strong>تعديل</strong> حجز</h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("Index")" class="btn btn-default btn-round">
                                <i class="fa fa-arrow-right"></i> العودة للقائمة
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    @using (Html.BeginForm("Edit", "SportReservations", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Partial("_CreateOrUpdate", Model)

                        <div class="row">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary btn-round">
                                    <i class="fa fa-save"></i> تحديث
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-default btn-round">
                                    إلغاء
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

