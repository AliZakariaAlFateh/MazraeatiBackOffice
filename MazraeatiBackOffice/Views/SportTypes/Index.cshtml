@model IEnumerable<SportTypeModel>

@{
    ViewBag.Title = "أنواع الرياضات";
    ViewBag.activePage = "أنواع الرياضات";
}

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2><strong>أنواع</strong> الرياضات</h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("Create")" class="btn btn-primary btn-round">
                                <i class="fa fa-plus"></i> إضافة نوع جديد
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>تم!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>خطأ!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <!-- فلتر البحث -->
                    <form action="" method="post">
                        <div class="row clearfix">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input id="searchInput" type="text" name="search" value="@ViewBag.search"
                                           placeholder="الكلمة المفتاحية" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group" style="margin-top: -10px;">
                                    <button type="submit" class="btn btn-primary btn-round">بحث</button>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group" style="margin-top: -10px;">
                                    <a href="@Url.Action("Index")" class="btn btn-primary btn-round">تفضية الحقول</a>
                                </div>
                            </div>
                        </div>
                    </form>

                    <!-- جدول أنواع الرياضات -->
                    <div class="tab-pane table-responsive active table-scroll table table-bordered">
                        <table class="table table-bordered table-striped table-hover" style="min-width: 1000px; width: 100%;">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>#</th>
                                    <th>النوع (عربي)</th>
                                    <th>النوع (إنجليزي)</th>
                                    <th>الأيقونة</th>
                                    <th>الحالة</th>
                                    <th colspan="3">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int counter = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@counter</td>
                                            <td><strong>@item.NameAr</strong></td>
                                            <td>@item.NameEn</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.IconClass))
                                                {
                                                    <i class="@item.IconClass"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge badge-success">نشط</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">غير نشط</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Edit", new { id = item.Id })" style="height: 25px;" class="btn btn-warning btn-round">
                                                    <i class="zmdi zmdi-edit" style="color: white;"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Index", "SportFeatures", new { sportTypeId = item.Id })" style="height: 25px;" class="btn btn-info btn-round" title="المرفقات الخاصة">
                                                    <i class="zmdi zmdi-star" style="color: white;"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="javascript:Delete('SportTypes',@item.Id,'Delete','Index')" class="btn btn-danger">
                                                    <i class="zmdi zmdi-delete" style="color: white;"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <div class="alert alert-info">
                                                لا توجد أنواع رياضات
                                                <br />
                                                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm mt-2">
                                                    <i class="fa fa-plus"></i> أضف نوع جديد
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>