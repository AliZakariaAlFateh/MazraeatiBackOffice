<style>
    .form-group {
        font-size: 13px;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 45px;
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 5px;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #2196f3;
            border: none;
            color: white;
            padding: 5px 10px;
            margin-top: 5px;
            border-radius: 20px;
            font-size: 13px;
        }

    .select2-selection__choice__remove {
        color: white !important;
        margin-left: 5px;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #2196f3;
        box-shadow: 0 0 5px rgba(33,150,243,0.3);
    }

    .select2-dropdown {
        border-radius: 10px;
        overflow: hidden;
    }

    .select2-results__option--highlighted {
        background-color: #2196f3 !important;
    }
</style>

@model CottageModel

<div class="container px-0">
    <div class="row g-4">
        <div class="col-12">
            <h5 class="text-decoration-underline text-gray-800 font-semibold text-lg mb-3">تفاصيل العقار</h5>
        </div>

        @if (Model.PropertyTemplates != null && Model.PropertyTemplates.Any())
        {
            int index = 0;
            foreach (var template in Model.PropertyTemplates)
            {
                var value = Model.PropertyValues.FirstOrDefault(v => v.PropertyTemplateId == template.Id);

                <div class="col-md-4 col-sm-6 col-12">
                    <div class="form-group mb-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            @template.PropertyLabelAr
                            @if (template.IsRequired)
                            {
                                <span class="text-red-500 text-lg">*</span>
                            }
                        </label>

                        @switch ((PropertyTypeEnum)template.PropertyType)
                        {
                            case PropertyTypeEnum.Text:
                                <br />
                                <input type="text"
                                       name="PropertyValues[@index].ValueText"
                                       value="@value?.ValueText"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 text-sm"
                                       @(template.IsRequired ? "required" : "") />
                                break;

                            case PropertyTypeEnum.Number:
                                <br />
                                <input type="number"
                                       step="any"
                                       name="PropertyValues[@index].ValueText"
                                       value="@value?.ValueText"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 text-sm"
                                       @(template.IsRequired ? "required" : "") />
                                break;

                            case PropertyTypeEnum.TextArea:
                                <textarea name="PropertyValues[@index].ValueText"
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 text-sm"
                          rows="3"
                          @(template.IsRequired ? "required" : "")">@value?.ValueText</textarea>
                                break;

                            case PropertyTypeEnum.Checkbox:
                                <div class="flex items-center mt-1">
                                    <input type="checkbox"
                                           name="PropertyValues[@index].ValueBool"
                                           value="true"
                                           class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-500 transition duration-150"
                                           @(value?.ValueBool == true ? "checked" : "") />
                                    <input type="hidden" name="PropertyValues[@index].ValueBool" value="false" />
                                    <span class="mr-2 text-sm text-gray-600">نعم</span>
                                </div>
                                break;

                            case PropertyTypeEnum.RadioButton:
                                if (template.Options != null && template.Options.Any())
                                {
                                    <div class="space-y-1 mt-1">
                                        @foreach (var option in template.Options)
                                        {
                                            <div class="flex items-center">
                                                <input type="radio"
                                                       name="PropertyValues[@index].ValueOptionId"
                                                       value="@option.Id"
                                                       class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500 transition duration-150"
                                                       @(value?.ValueOptionId == option.Id ? "checked" : "")
                                                       @(template.IsRequired ? "required" : "") />
                                                <label class="mr-2 text-sm text-gray-700">@option.OptionTextAr</label>
                                            </div>
                                        }
                                    </div>
                                }
                                break;

                            case PropertyTypeEnum.Dropdown:
                                <select name="PropertyValues[@index].ValueOptionId"
                                        class="select2 w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 text-sm"
                                        @(template.IsRequired ? "required" : "")>
                                    <option value="">-- اختر --</option>
                                    @foreach (var option in template.Options)
                                    {
                                        <option value="@option.Id" selected="@(value?.ValueOptionId == option.Id)">
                                            @option.OptionTextAr
                                        </option>
                                    }
                                </select>
                                break;
                        }

                        <!-- Hidden Fields -->
                        <input type="hidden" name="PropertyValues[@index].PropertyTemplateId" value="@template.Id" />
                        <input type="hidden" name="PropertyValues[@index].SportId" value="@Model.Id" />
                        <input type="hidden" name="PropertyValues[@index].PropertyType" value="@template.PropertyType" />
                    </div>
                </div>

                index++;
            }
        }
        else
        {
            <div class="col-12">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-blue-700 flex items-center gap-2 alert alert-info">
                    <i class="fa fa-info-circle text-blue-500"></i>
                        <span>لا توجد تفاصيل عقار</span>
                </div>
            </div>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
    // ===== تهيئة الـ Select2 =====
    $('.select2').select2({
        placeholder: "اختر من القائمة",
        width: '100%',
        dir: "rtl",
        closeOnSelect: false
    });
</script>