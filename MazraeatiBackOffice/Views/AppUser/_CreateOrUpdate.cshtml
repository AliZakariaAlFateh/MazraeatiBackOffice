@using MazraeatiBackOffice.Models.UserManagementModel
@model UserModel

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<style>

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #2d8027 !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove 
    {
        font-size:1.3rem !important;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover, .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:focus {
            background-color: #f00 !important;
            color: #333;
            outline: none
        }
    .form-group {
        font-size: 13px;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 45px;
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 5px;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #2196f3;
            border: none;
            color: white;
            padding: 5px 10px;
            margin-top: 5px;
            border-radius: 20px;
            font-size: 13px;
        }

    .select2-selection__choice__remove {
        color: white !important;
        margin-left: 5px;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #2196f3;
        box-shadow: 0 0 5px rgba(33,150,243,0.3);
    }

    .select2-dropdown {
        border-radius: 10px;
        overflow: hidden;
    }

    .select2-results__option--highlighted {
        background-color: #2196f3 !important;
    }
</style>

<link href="~/assets/css/appuser.css" rel="stylesheet" />

@Html.HiddenFor(a => a.Id)

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2><strong>معالجة </strong> السجل</h2>
                    <ul class="header-dropdown">
                        @if (Model.Id > 0)
                        {
                            <li>
                                <a href="@Url.Action("Create")" class="btn btn-primary btn-round">
                                    <i class="fa fa-plus"></i> إضافة / جديد
                                </a>
                            </li>
                        }
                        <li>
                            <a href="@Url.Action("Index")" class="btn btn-default btn-round">
                                <i class="fa fa-arrow-right"></i> العودة للقائمة
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    <div class="row clearfix">
                        <!-- ID مخفي -->
                        <div class="col-sm-12 d-none">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.Id)
                                @Html.TextBoxFor(a => a.Id, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>

                        <!-- اسم المستخدم -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.UserName)
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(a => a.UserName, new { @class = "form-control", @autocomplete = "off" })
                                @Html.ValidationMessageFor(a => a.UserName, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- رقم الواتساب -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.MobilePhone)
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(a => a.MobilePhone, new { @class = "form-control", @id = "phone1", @dir = "ltr" })
                                @Html.ValidationMessageFor(a => a.MobilePhone, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- رقم الجوال -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.MobileNumber)
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(a => a.MobileNumber, new { @class = "form-control", @id = "phone2", @dir = "ltr" })
                                @Html.ValidationMessageFor(a => a.MobileNumber, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- كلمة المرور -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.PasswordHash)
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(a => a.PasswordHash, new { @class = "form-control", @autocomplete = "off" })
                                @Html.ValidationMessageFor(a => a.PasswordHash, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- ===== نوع العقار (MultiSelect Dropdown) ===== -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>نوع العقار <span class="text-danger">*</span></label>
                                @Html.ListBoxFor(model => model.UserTypeListSelected,
                                Model.UserTypeList,
                                                                new
                                                                {
                                                                    @class = "form-control select2",
                                                                    multiple = "multiple",
                                                                    style = "width:100%"
                                                                })
                                @Html.ValidationMessageFor(a => a.UserType, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- ===== المزارع ===== -->
                        <div class="col-sm-6" id="farmsContainer">
                            <div class="form-group">
                                <label>المزارع</label>
                                @Html.ListBoxFor(model => model.FarmIds,
                                                                Model.Farms,
                                                                new
                                                                {
                                                                    @class = "form-control select2",
                                                                    multiple = "multiple",
                                                                    style = "width:100%"
                                                                })
                                @Html.ValidationMessageFor(a => a.FarmIds, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>

                        <!-- ===== العقار الرياضي ===== -->
                        <div class="col-sm-6" id="sportsContainer">
                            <div class="form-group">
                                <label>العقار الرياضي</label>
                                @Html.ListBoxFor(model => model.SportIds,
                                                                Model.Sports,
                                                                new
                                                                {
                                                                    @class = "form-control select2",
                                                                    multiple = "multiple",
                                                                    style = "width:100%"
                                                                })
                                @Html.ValidationMessageFor(a => a.SportIds, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>
                        <div class="col-sm-6" id="cottagesContainer">
                            <div class="form-group">
                                <label>الأكواخ</label>
                                @Html.ListBoxFor(model => model.CottageIds,
                                                                Model.Cottages,
                                                                new
                                                                {
                                                                    @class = "form-control select2",
                                                                    multiple = "multiple",
                                                                    style = "width:100%"
                                                                })
                                @Html.ValidationMessageFor(a => a.CottageIds, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>
                        <!-- نشط -->
                        <div class="col-sm-3">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.IsActive)
                                <br />
                                @Html.CheckBoxFor(a => a.IsActive, new { @class = "form-control", style = "margin-top: 10px; width:20px !important; height:20px;" })
                            </div>
                        </div>

                        <!-- أزرار -->
                        <div class="col-sm-12">
                            <button type="submit" class="btn btn-primary btn-round">حفظ</button>
                            <button type="button" onclick="window.location.href='@Url.Content("~/AppUser/index/")'" class="btn btn-default btn-round btn-simple">رجوع</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // ===== تخزين القيم المختارة الأولية =====
        var initialFarmIds = [];
        var initialSportIds = [];
        var initialCottageIds = [];

        // ===== تهيئة الـ Select2 =====
        $('.select2').select2({
            placeholder: "اختر من القائمة",
            width: '100%',
            dir: "rtl",
            closeOnSelect: false
        });

        // ===== دالة جلب المزارع =====
        function loadFarms(callback) {
            $.ajax({
                url: '@Url.Action("GetFarmsByUserType", "AppUser")',
                type: 'GET',
                data: { userType: "0" },
                success: function (data) {
                    if (callback) callback(data);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        // ===== دالة جلب الأكواخ =====
        function loadCottages(callback) {
            $.ajax({
                url: '@Url.Action("GetCottagesByUserType", "AppUser")',
                type: 'GET',
                data: { userType: "13" },
                success: function (data) {
                    if (callback) callback(data);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        // ===== دالة تحديث قائمة المزارع مع الاحتفاظ بالقيم المختارة =====
        function updateFarmsList(newItems, selectedIds) {
            var select = $('#FarmIds');
            select.find('option').remove();

            $.each(newItems, function (index, item) {
                select.append('<option value="' + item.id + '">' + (item.name || item.nameAr) + '</option>');
            });

            // ===== إعادة تعيين القيم المختارة =====
            if (selectedIds && selectedIds.length > 0) {
                select.val(selectedIds).trigger('change');
            } else {
                select.val(null).trigger('change');
            }
        }

        // ===== دالة تحديث قائمة الأكواخ مع الاحتفاظ بالقيم المختارة =====
        function updateCottagesList(newItems, selectedIds) {
            var select = $('#CottageIds');
            select.find('option').remove();

            $.each(newItems, function (index, item) {
                select.append('<option value="' + item.id + '">' + (item.nameAr || item.name) + '</option>');
            });

            if (selectedIds && selectedIds.length > 0) {
                select.val(selectedIds).trigger('change');
            } else {
                select.val(null).trigger('change');
            }
        }

        // ===== دالة تحديث قائمة العقارات الرياضية مع الاحتفاظ بالقيم المختارة =====
        function updateSportsList(newItems, selectedIds) {
            var select = $('#SportIds');
            select.find('option').remove();

            $.each(newItems, function (index, item) {
                select.append('<option value="' + item.id + '">' + (item.nameAr || item.name) + '</option>');
            });

            if (selectedIds && selectedIds.length > 0) {
                select.val(selectedIds).trigger('change');
            } else {
                select.val(null).trigger('change');
            }
        }

        // ===== دالة التعامل مع تغيير نوع العقار =====
        function handleUserTypeChange() {
            var selectedTypes = $('#UserTypeListSelected').val() || [];

            // ===== الحفاظ على القيم المختارة الحالية =====
            var currentFarmIds = $('#FarmIds').val() || [];
            var currentSportIds = $('#SportIds').val() || [];
            var currentCottageIds = $('#CottageIds').val() || [];

            // ===== 1. المزارع =====
            if (selectedTypes.includes('0')) {
                $('#farmsContainer').show();
                loadFarms(function (data) {
                    updateFarmsList(data, currentFarmIds);
                });
            } else {
                $('#farmsContainer').hide();
                $('#FarmIds').val(null).trigger('change');
            }

            // ===== 2. الأكواخ =====
            if (selectedTypes.includes('13')) {
                $('#cottagesContainer').show();
                loadCottages(function (data) {
                    updateCottagesList(data, currentCottageIds);
                });
            } else {
                $('#cottagesContainer').hide();
                $('#CottageIds').val(null).trigger('change');
            }

            // ===== 3. العقارات الرياضية =====
            var sportTypes = selectedTypes.filter(function (val) {
                return val !== '0' && val !== '13';
            });

            if (sportTypes.length > 0) {
                $('#sportsContainer').show();

                $.ajax({
                    url: '@Url.Action("GetAllSportsByTypes", "AppUser")',
                    type: 'GET',
                    data: { sportTypeIds: sportTypes.join(',') },
                    success: function (data) {
                        updateSportsList(data, currentSportIds);
                    },
                    error: function () {
                        updateSportsList([], currentSportIds);
                    }
                });
            } else {
                $('#sportsContainer').hide();
                $('#SportIds').val(null).trigger('change');
            }
        }

        // ===== دالة حفظ القيم المختارة الأولية =====
        function saveInitialSelectedValues() {
            initialFarmIds = $('#FarmIds').val() || [];
            initialSportIds = $('#SportIds').val() || [];
            initialCottageIds = $('#CottageIds').val() || [];
        }

        // ===== ربط الأحداث =====
        $('#UserTypeListSelected').on('change', function () {
            handleUserTypeChange();
        });

        // ===== عند تحميل الصفحة =====
        // 1. حفظ القيم المختارة الأولية
        saveInitialSelectedValues();

        // 2. تنفيذ الـ handle مع الاحتفاظ بالقيم
        handleUserTypeChange();

        // ===== دالة رقم الهاتف =====
        function initPhone(inputId) {
            var input = document.querySelector(inputId);
            if (!input) return null;

            var iti = window.intlTelInput(input, {
                initialCountry: "auto",
                geoIpLookup: function (callback) {
                    $.get("https://ipapi.co/json/", function (data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function () {
                        callback("eg");
                    });
                },
                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });

            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }
            return iti;
        }

        var iti1 = initPhone("#phone1");
        var iti2 = initPhone("#phone2");

        // ===== عند إرسال النموذج =====
        $("form").on("submit", function () {
            if (iti1 && !iti1.isValidNumber()) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'رقم الموبايل الأول غير صحيح' });
                return false;
            }

            if (iti2 && !iti2.isValidNumber()) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'رقم الموبايل الثاني غير صحيح' });
                return false;
            }

            if (iti1) $("#phone1").val(iti1.getNumber());
            if (iti2) $("#phone2").val(iti2.getNumber());

            var selectedTypes = $('#UserTypeListSelected').val() || [];
            $('#UserType').val(selectedTypes.join(','));
        });
    });
</script>