            $(document).ready(function () {
        // ===== تهيئة الـ Select2 =====
        $('.select2').select2({
            placeholder: "اختر من القائمة",
            width: '100%',
            dir: "rtl",
            closeOnSelect: false
        });

        // ===== دالة جلب العقارات الرياضية حسب النوع =====
        function loadSportsByType(sportTypeId, callback) {
            if (!sportTypeId) {
                if (callback) callback([]);
                return;
            }

            $.ajax({
                url: '@Url.Action("GetSportsByUserType", "AppUser")',
                type: 'GET',
                data: { userType: sportTypeId },
                success: function (data) {
                    if (callback) callback(data);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        // ===== دالة جلب المزارع =====
        function loadFarms(callback) {
            $.ajax({
                url: '@Url.Action("GetFarmsByUserType", "AppUser")',
                type: 'GET',
                data: { userType: "0" },
                success: function (data) {
                    if (callback) callback(data);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        // ===== دالة إضافة العقارات إلى الليست (من غير selected) =====
        function addSportsToList(newItems) {
            var select = $('#SportIds');

            // إضافة العناصر الجديدة (اللي مش موجودة)
            $.each(newItems, function (index, item) {
                var exists = select.find('option[value="' + item.id + '"]').length > 0;
                if (!exists) {
                    select.append('<option value="' + item.id + '">' + (item.nameAr || item.name) + '</option>');
                }
            });

            // ===== مهم جداً: من غير ما نختارهم =====
            // خلينا القيم المختارة زي ما هي من غير تغيير
            // select.val(select.val()).trigger('change');
        }

        // ===== دالة إزالة العقارات حسب النوع =====
        function removeSportsByType(sportTypeId) {
            var select = $('#SportIds');
            var currentValues = select.val() || [];

            $.ajax({
                url: '@Url.Action("GetSportsByUserType", "AppUser")',
                type: 'GET',
                data: { userType: sportTypeId },
                success: function (data) {
                    var idsToRemove = data.map(function (item) { return item.id.toString(); });

                    // حذف الخيارات
                    $.each(idsToRemove, function (index, id) {
                        select.find('option[value="' + id + '"]').remove();
                    });

                    // حذف القيم المختارة (لو كانت موجودة)
                    var newValues = currentValues.filter(function (val) {
                        return !idsToRemove.includes(val);
                    });

                    select.val(newValues).trigger('change');
                }
            });
        }

        // ===== دالة تحديث قائمة المزارع =====
        function updateFarmsList(newItems) {
            var select = $('#FarmIds');
            select.find('option').remove();
            select.val(null).trigger('change');

            $.each(newItems, function (index, item) {
                select.append('<option value="' + item.id + '">' + (item.name || item.nameAr) + '</option>');
            });
        }

        // ===== دالة التعامل مع تغيير نوع العقار =====
        function handleUserTypeChange() {
            var selectedTypes = $('#UserTypeListSelected').val() || [];

            // ===== 1. المزارع =====
            if (selectedTypes.includes('0')) {
                $('#farmsContainer').show();
                loadFarms(function (data) {
                    updateFarmsList(data);
                });
            } else {
                $('#farmsContainer').hide();
                $('#FarmIds').val(null).trigger('change');
            }

            // ===== 2. العقارات الرياضية (تراكمي) =====
            var sportTypes = selectedTypes.filter(function (val) { return val !== '0'; });

            if (sportTypes.length > 0) {
                $('#sportsContainer').show();

                // جلب الأنواع الموجودة حالياً في الليست
                var select = $('#SportIds');
                var existingOptions = [];
                select.find('option').each(function () {
                    existingOptions.push($(this).val());
                });

                // حذف الخيارات اللي مش موجودة في الأنواع المختارة
                // جلب كل العقارات من كل الأنواع المختارة
                $.ajax({
                    url: '@Url.Action("GetAllSportsByTypes", "AppUser")',
                    type: 'GET',
                    data: { sportTypeIds: sportTypes.join(',') },
                    success: function (data) {
                        // إعادة بناء الليست
                        select.find('option').remove();
                        select.val(null).trigger('change');

                        // إضافة كل العقارات من الأنواع المختارة
                        $.each(data, function (index, item) {
                            select.append('<option value="' + item.id + '">' + (item.nameAr || item.name) + '</option>');
                        });

                        // ===== من غير ما نختار أي حاجة =====
                        // خلينا الـ selected فاضي
                        select.val([]).trigger('change');
                    }
                });

            } else {
                $('#sportsContainer').hide();
                $('#SportIds').val(null).trigger('change');
            }
        }

        // ===== ربط الأحداث =====
        $('#UserTypeListSelected').on('change', function () {
            handleUserTypeChange();
        });

        // ===== عند تحميل الصفحة =====
        handleUserTypeChange();

        // ===== دالة رقم الهاتف =====
        function initPhone(inputId) {
            var input = document.querySelector(inputId);
            var iti = window.intlTelInput(input, {
                initialCountry: "auto",
                geoIpLookup: function (callback) {
                    $.get("https://ipapi.co/json/", function (data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function () {
                        callback("eg");
                    });
                },
                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });

            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }
            return iti;
        }

        var iti1 = initPhone("#phone1");
        var iti2 = initPhone("#phone2");

        // ===== عند إرسال النموذج =====
        $("form").on("submit", function () {
            if (!iti1.isValidNumber()) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'رقم الموبايل الأول غير صحيح' });
                return false;
            }

            if (!iti2.isValidNumber()) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'رقم الموبايل الثاني غير صحيح' });
                return false;
            }

            $("#phone1").val(iti1.getNumber());
            $("#phone2").val(iti2.getNumber());

            var selectedTypes = $('#UserTypeListSelected').val() || [];
            $('#UserType').val(selectedTypes.join(','));
        });
    });
</script>