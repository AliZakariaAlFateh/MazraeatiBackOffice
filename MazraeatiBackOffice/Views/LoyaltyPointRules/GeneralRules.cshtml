@using MazraeatiBackOffice.Core.LoyaltyPoints
@using MazraeatiBackOffice.Models.LoyaltyPoints
@model List<LoyaltyPointRuleGeneralModel>

@{
    ViewBag.Title = $"القواعد العامة للنقاط";
    ViewBag.activePage = "قواعد النقاط";
}

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card">
                <div class="header">
                    <h2>
                        <strong>القواعد العامة</strong> للنقاط
                        <small>@ViewBag.ActivityTypeName</small>
                    </h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("CreateGeneralRule", new { activityTypeId = ViewBag.ActivityTypeId })" class="btn btn-primary btn-round">
                                <i class="fa fa-plus"></i> إضافة قاعدة جديدة
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    <!-- نموذج إضافة قاعدة -->
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5><i class="fa fa-plus"></i> إضافة قاعدة عامة جديدة</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" action="@Url.Action("GeneralRules", "LoyaltyPointRules")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ActivityTypeId" value="@ViewBag.ActivityTypeId" />
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label>نوع النشاط <span class="text-danger">*</span></label>
                                            <select class="form-control select2" name="ActivityTypeId" required>
                                                <option value="">-- اختر --</option>
                                                @foreach (var item in ViewBag.ActivityTypes)
                                                {
                                                    <option value="@item.Id" selected="@(item.Id == ViewBag.ActivityTypeId)">@item.NameAr</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label>عدد النقاط <span class="text-danger">*</span></label>
                                            <input type="number" name="Points" class="form-control" required min="1" />
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label>قاعدة افتراضية</label>
                                            <br />
                                            <input type="checkbox" name="IsDefault" value="true" class="form-control" style="width:20px;height:20px;margin-top:5px;" />
                                            <input type="hidden" name="IsDefault" value="false" />
                                        </div>
                                    </div>
                                    <div class="col-sm-3" style="padding-top:22px;">
                                        <button type="submit" class="btn btn-primary btn-round">
                                            <i class="fa fa-save"></i> إضافة
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- الجدول -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>#</th>
                                    <th>النشاط</th>
                                    <th>النقاط</th>
                                    <th>افتراضي</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int counter = 1;
                                    foreach (var item in Model)
                                    {
                                        var activityTypes = ViewBag.ActivityTypes as List<LoyaltyActivityType>;
                                        var activity = activityTypes?.FirstOrDefault(a => a.Id == item.ActivityTypeId);
                                        <tr>
                                            <td>@counter</td>
                                            <td>@activity?.NameAr</td>
                                            <td><strong>@item.Points</strong></td>
                                            <td>
                                                @if (item.IsDefault)
                                                {
                                                    <span class="badge badge-success">نعم</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge badge-success">نشط</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">غير نشط</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="javascript:deleteGeneralRule(@item.Id)" class="btn btn-danger">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <div class="alert alert-info">
                                                <i class="fa fa-info-circle"></i> لا توجد قواعد عامة
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteGeneralRule(id) {
        if (confirm('هل أنت متأكد من حذف هذه القاعدة؟')) {
            $.ajax({
                url: '/LoyaltyPointRules/DeleteGeneralRule/' + id,
                type: 'POST',
                success: function(data) {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                }
            });
        }
    }

    $(document).ready(function() {
        $('.select2').select2();
    });
</script>