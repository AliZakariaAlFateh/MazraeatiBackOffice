@using MazraeatiBackOffice.Models.LoyaltyPoints
@model List<LoyaltyActivityTypeModel>

@{
    ViewBag.Title = "أنواع الأنشطة";
    ViewBag.activePage = "أنواع الأنشطة";
}

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card">
                <div class="header">
                    <h2><strong>أنواع</strong> الأنشطة</h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("Create")" class="btn btn-primary btn-round">
                                <i class="fa fa-plus"></i> إضافة نشاط جديد
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success"><strong>تم!</strong> @TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger"><strong>خطأ!</strong> @TempData["ErrorMessage"]</div>
                    }

                    <!-- فلتر -->
                    <form method="post">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input type="text" name="search" value="@ViewBag.search" placeholder="بحث..." class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-primary">بحث</button>
                                <a href="@Url.Action("Index")" class="btn btn-default">تفريغ</a>
                            </div>
                        </div>
                    </form>

                    <!-- الجدول -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>#</th>
                                    <th>الاسم</th>
                                    <th>الكود</th>
                                    <th>الأيقونة</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int counter = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@counter</td>
                                            <td><strong>@item.NameAr</strong></td>
                                            <td><code>@item.Code</code></td>
                                            @* <td>@item.SportTypeId</td> *@
                                            <td><i class="@item.IconClass"></i></td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge badge-success">نشط</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">غير نشط</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("SportRules", "LoyaltyPointRules", new { activityTypeId = item.Id })" class="btn btn-info" title="قواعد النقاط">
                                                        <i class="fa fa-cog"></i>
                                                    </a>
                                                    <a href="javascript:deleteItem(@item.Id)" class="btn btn-danger">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteItem(id) {
        if (confirm('هل أنت متأكد من حذف هذا النشاط؟')) {
            $.ajax({
                url: '/LoyaltyActivityTypes/Delete/' + id,
                type: 'POST',
                success: function(data) {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                }
            });
        }
    }
</script>