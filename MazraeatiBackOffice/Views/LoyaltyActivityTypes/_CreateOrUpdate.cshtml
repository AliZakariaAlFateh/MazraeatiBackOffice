@using MazraeatiBackOffice.Models.LoyaltyPoints
@model LoyaltyActivityTypeModel
<style>
    .form-group { font-size: 13px; }
</style>

@Html.HiddenFor(a => a.Id)
@Html.HiddenFor(a => a.CreatedDate)

<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2>
                        <strong>@(Model.Id > 0 ? "تعديل" : "إضافة")</strong>
                        نشاط
                    </h2>
                    <ul class="header-dropdown">
                        <li>
                            <a href="@Url.Action("Index")" class="btn btn-default btn-round">
                                <i class="fa fa-arrow-right"></i> العودة للقائمة
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="row clearfix">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.NameAr)
                                    @Html.TextBoxFor(a => a.NameAr, new { @class = "form-control", required = "required" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.NameEn)
                                    @Html.TextBoxFor(a => a.NameEn, new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.Code)
                                    @Html.TextBoxFor(a => a.Code, new { @class = "form-control", required = "required" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class-form-group">
                                    @Html.DisplayNameFor(a => a.SportTypeId)
                                    <select class="form-control" name="SportTypeId">
                                        <option value="">-- غير مرتبط --</option>
                                        @foreach (var item in ViewBag.SportTypes)
                                        {
                                            <option value="@item.Id" selected="@(item.Id == Model.SportTypeId)">@item.NameAr</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.IconClass)
                                    @Html.TextBoxFor(a => a.IconClass, new { @class = "form-control", placeholder = "fa-tree" })
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    @Html.DisplayNameFor(a => a.IsActive)
                                    <br />
                                    @Html.CheckBoxFor(a => a.IsActive, new { @class = "form-control", style = "width:20px;height:20px;margin-top:5px;" })
                                </div>
                            </div>

                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary">@(Model.Id > 0 ? "تحديث" : "حفظ")</button>
                                <a href="@Url.Action("Index")" class="btn btn-default">رجوع</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>