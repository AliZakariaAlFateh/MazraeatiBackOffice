<style>
    .table-scroll {
        height: 350px;
        overflow-y: scroll;
    }

        /* Sticky header */
        .table-scroll thead th {
            position: sticky;
            top: 0;
            background: #198754;
            color: #fff;
            z-index: 10;
        }

        /* Chrome / Edge */
        .table-scroll::-webkit-scrollbar {
            width: 12px;
        }

        .table-scroll::-webkit-scrollbar-track {
            background: #eee;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: #999;
            border-radius: 10px;
            border: 2px solid #eee;
        }

            .table-scroll::-webkit-scrollbar-thumb:hover {
                background: #666;
            }

    /* Firefox */
    .table-scroll {
        scrollbar-width: auto;
        scrollbar-color: #999 #eee;
    }
</style>
@model IEnumerable<RegionModel>
<div class="col-md-12">
    <div class="card patients-list">
        <div class="header">
            <h2><strong>قائمة</strong> المناطق</h2>
            <ul class="header-dropdown">
            </ul>
        </div>
        <div class="body">
            <!-- Nav tabs -->
            @Html.Partial("_search")
           @* <a class="btn btn-success" href="@Url.Action("Create","Region", new { cityid = ViewBag.CityId })">
                إضافة سجل جديد
            </a> *@
            <!-- Tab panes -->
            <div class="tab-content m-t-10">
                <div class="tab-pane table-responsive active table-scroll" id="All">
                    <table class="table m-b-0 table-hover">
                        <thead style="background-color:#FD9C4E;color:white">
                            <tr>
                                <th>#</th>
                                <th>@Html.DisplayNameFor(a => a.DescAr)</th>
                                <th>@Html.DisplayNameFor(a => a.DescEn)</th>
                                <th>@Html.DisplayNameFor(a => a.CityId)</th>
                                <th>تفاصيل</th>
                                <th>حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.DescAr</td>
                                <td>@item.DescEn</td>
                                <td>@item.CityName</td>
                                <td><a href="@Url.Content("~/region/edit/")@item.Id" style="height: 25px;" class="btn btn-primary btn-round"><i class="zmdi zmdi-edit" style="color: white;margin-top: -10px;"></i></a></td>
                                <td>
                                    <a href="javascript:Delete('region',@item.Id,'Delete','Index')" class="btn btn-danger btn-sm">حذف</a>
                                </td>
                            </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
