@model IEnumerable<CustomerModel>
<div class="col-md-12">
    <div class="card patients-list">
        <div class="header">
            <h2><strong>قائمة</strong> العملاء</h2>
            <ul class="header-dropdown">
            </ul>
        </div>
        <div class="body">
            <!-- Nav tabs -->
            @Html.Partial("_search")
            <!-- Tab panes -->
            @if (Model.Any())
            {
                <div class="tab-content m-t-10">
                    <div class="tab-pane table-responsive active table-scroll table table-bordered" id="All">
                        <table class="table m-b-0 table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@Html.DisplayNameFor(a => a.FullName)</th>
                                    <th>@Html.DisplayNameFor(a => a.MobileNumber)</th>
                                    <th>تفاصيل</th>
                                    <th>حذف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int count = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.FullName</td>
                                        <td>@item.MobileNumber</td>
                                        <td>
                                            <a href="@Url.Content("~/Customer/edit/")@item.Id" style="height: 25px;" class="btn btn-info"><i class="fa fa-edit" style="color: white;margin-top: -10px;"></i>تعديل</a>
                                            <a href="@Url.Content("~/LoyaltyTransactions/CustomerTransactions?customerId=")@item.Id" style="height: 25px;" class="btn btn-info"><i class="fa fa-history" style="color: white;margin-top: -10px;"></i>حركات النقاط</a>
                                            </td>
                                        <td>
                                            <a href="javascript:Delete('Customer',@item.Id,'Delete','Index')" class="btn btn-danger btn-sm">حذف</a>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {

                <div class="empty-state-container">
                    <div class="empty-state-icon">
                        <i class="zmdi zmdi-search-for-wild"></i> 

                    </div>
                    <div class="empty-state-title">لا توجد بيانات حالياً</div>
                    <div class="empty-state-description">لا توجد بيانات ليتم عرضها يمكنك اضافة بيانات ليتم عرضها هنا </div>
                </div>
            }
        </div>
    </div>
</div>