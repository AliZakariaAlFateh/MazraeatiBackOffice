@Html.HiddenFor(a => a.Id)
<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="header">
                    <h2><strong>معالجة </strong> السجل</h2>
                    <ul class="header-dropdown">
                    </ul>
                </div>
                <div class="body">
                    <div class="row clearfix">
                        <div class="col-sm-12 d-none">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.Id)
                                @Html.TextBoxFor(a => a.Id, new { @class = "form-control", @autocomplete = "off", @readonly = "readonly" })
                                @Html.ValidationMessageFor(a => a.Id, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.FullName)
                                @Html.TextBoxFor(a => a.FullName, new { @class = "form-control", @autocomplete = "off" })
                                @Html.ValidationMessageFor(a => a.FullName, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.DisplayNameFor(a => a.MobileNumber)
                                @Html.TextBoxFor(a => a.MobileNumber, new { @class = "form-control", @autocomplete = "off", @id = "phone1", @dir = "ltr" })
                                @Html.ValidationMessageFor(a => a.MobileNumber, "", new { @style = "color:red;font-size:10px" })
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <button type="submit" class="btn btn-primary btn-round">حفظ</button>
                            <button type="button" onclick="window.location.href='@Url.Content("~/Customer/index/")'" class="btn btn-default btn-round btn-simple">رجوع</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@* <script src="~/assets/js/multipeselect.js"></script> *@
<script>
    $(document).ready(function () {

        function initPhone(inputId) {

            var input = document.querySelector(inputId);

            var iti = window.intlTelInput(input, {

                initialCountry: "auto",

                geoIpLookup: function (callback) {
                    $.get("https://ipapi.co/json/", function (data) {
                        callback(data.country_code.toLowerCase());
                    }).fail(function () {
                        callback("eg"); // fallback
                    });
                },

                separateDialCode: true,
                preferredCountries: ["eg", "sa", "ae", "jo"],

                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
            });

            // لو فيه رقم جاى من DB
            var existingValue = $(inputId).val();
            if (existingValue) {
                iti.setNumber(existingValue);
            }

            return iti;
        }

        // Initialize الاتنين
        var iti1 = initPhone("#phone1");

        // ============================
        // Submit
        // ============================
        $("form").on("submit", function () {

            // تأكد إن utils اتحمل
            if (!iti1.isValidNumber()) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ',
                    text: 'رقم الموبايل غير صحيح'
                });
                return false;
            }

            $("#phone1").val(iti1.getNumber());
        });

    });
</script>
